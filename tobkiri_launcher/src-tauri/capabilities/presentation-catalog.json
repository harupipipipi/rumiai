{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "presentation-catalog",
  "description": "Read-only presentation catalog access for the Launcher panel",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8765/panel",
      "http://127.0.0.1:8765/panel/*",
      "http://localhost:8765/panel",
      "http://localhost:8765/panel/*"
    ]
  },
  "permissions": ["allow-get-presentation-catalog"]
}
