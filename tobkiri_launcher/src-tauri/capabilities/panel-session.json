{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel-session",
  "description": "Allows only the primary Tobkiri panel to renew its short-lived local API session.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8765/*",
      "http://localhost:8765/*",
      "http://127.0.0.1:8766/*",
      "http://localhost:8766/*"
    ]
  },
  "permissions": ["allow-reauthorize-panel-session"]
}
