{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "presentation-control",
  "description": "Presentation selection and launch access for the Launcher panel",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8765/panel",
      "http://127.0.0.1:8765/panel/*",
      "http://localhost:8765/panel",
      "http://localhost:8765/panel/*"
    ]
  },
  "permissions": [
    "allow-select-presentation",
    "allow-launch-selected-presentation"
  ]
}
