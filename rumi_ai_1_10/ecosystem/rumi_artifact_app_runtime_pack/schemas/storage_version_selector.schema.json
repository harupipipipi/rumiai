{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/storage_version_selector.schema.json",
  "title": "Storage Version Selector",
  "description": "Read-only selector for artifact versions and storage refs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selector_id",
    "artifact_id",
    "selector_kind",
    "pinned_version_id",
    "checksum",
    "storage_owner",
    "path_policy",
    "source_owner",
    "source_ref",
    "read_only",
    "allowed_sources",
    "client_supplied_path_trusted"
  ],
  "properties": {
    "selector_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "selector_kind": {
      "type": "string",
      "enum": [
        "latest",
        "pinned_version",
        "checksum_pin"
      ]
    },
    "pinned_version_id": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    },
    "storage_owner": {
      "type": "string",
      "enum": [
        "defaultspack",
        "rumi_workspace_pack"
      ]
    },
    "path_policy": {
      "type": "string",
      "enum": [
        "no_path_traversal",
        "trusted_workspace_only"
      ]
    },
    "source_owner": {
      "type": "string",
      "enum": [
        "defaultspack",
        "rumi_workspace_pack"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "defaultspack_artifact_index",
            "defaultspack_chat_workspace",
            "trusted_workspace_record"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "read_only": {
      "type": "boolean",
      "const": true
    },
    "allowed_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "defaultspack_artifact_index",
          "defaultspack_chat_workspace",
          "trusted_workspace_record"
        ]
      }
    },
    "client_supplied_path_trusted": {
      "type": "boolean",
      "const": false
    }
  }
}
