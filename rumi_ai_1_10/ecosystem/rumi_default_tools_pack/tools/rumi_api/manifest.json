{
  "id": "rumi_api",
  "category": "tool",
  "version": "1",
  "display_name": "Rumi API",
  "description": "Inspect and call the local defaultspack API from agents.",
  "enabled": true,
  "config": {
    "name": "rumi_api",
    "summary": "Rumi API",
    "tags": ["api", "rumi", "agent", "operations"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list_routes", "request"],
            "default": "list_routes"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE"],
            "default": "GET"
          },
          "path": {"type": "string"},
          "body": {"type": "object"},
          "allow_mutation": {"type": "boolean", "default": false}
        }
      }
    },
    "tool_category": "network",
    "action_type": "read",
    "risk": "medium",
    "approval_policy": "ask",
    "capability_grants": ["network.read", "network.send"],
    "execution": {
      "type": "rumi_function",
      "qualified_name": "rumi_default_tools_pack:rumi_api"
    },
    "requires_approval": true,
    "ui": {
      "group_id": "agent",
      "group_label": "Agent",
      "composer_label": "Rumi API",
      "composer_icon": "plug",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "api_base_url",
          "label": "API base URL",
          "type": "text",
          "default": "http://127.0.0.1:8766",
          "help": "Saved default local API origin for agent API calls."
        },
        {
          "id": "api_profile",
          "label": "API profile",
          "type": "select",
          "default": "local",
          "options": [
            {"value": "local", "label": "Local"},
            {"value": "development", "label": "Development"},
            {"value": "custom", "label": "Custom"}
          ],
          "help": "Saved profile preference for selecting an API environment."
        }
      ]
    }
  }
}
