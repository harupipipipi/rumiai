{
  "id": "web_search",
  "category": "tool",
  "version": "1",
  "display_name": "Web Search",
  "description": "Basic web search tool extension.",
  "enabled": true,
  "config": {
    "name": "web_search",
    "summary": "ウェブ検索",
    "tags": ["search"],
    "ui": {
      "group_id": "research",
      "group_label": "Research",
      "group_icon": "search",
      "item_icon": "search",
      "widget_kind": "tool_toggle",
      "drop_capabilities": [
        "composer.toggle_chip"
      ],
      "composer_label": "Web Search",
      "composer_description": "現在のWeb情報を検索します。",
      "composer_icon": "search",
      "settings_fields": [
        {
          "id": "default_result_limit",
          "label": "Result limit",
          "type": "number",
          "default": 5,
          "min": 1,
          "max": 20,
          "help": "Saved default for the number of search results to return."
        },
        {
          "id": "freshness_window",
          "label": "Freshness",
          "type": "select",
          "default": "any",
          "options": [
            {"value": "any", "label": "Any time"},
            {"value": "day", "label": "Past day"},
            {"value": "week", "label": "Past week"},
            {"value": "month", "label": "Past month"}
          ],
          "help": "Saved default recency preference for web results."
        },
        {
          "id": "safe_search",
          "label": "Safe search",
          "type": "toggle",
          "default": true,
          "help": "Saved preference for filtering explicit search results."
        }
      ]
    },
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string"}
        },
        "required": ["query"]
      }
    },
    "tool_category": "network",
    "action_type": "read",
    "risk": "medium",
    "approval_policy": "allow",
    "capability_grants": ["network.read"],
    "execution": {
      "type": "rumi_function",
      "qualified_name": "defaultspack:tool_web_search"
    }
  }
}
