{
  "id": "todo",
  "category": "tool",
  "version": "1",
  "display_name": "Todo",
  "description": "Create and maintain per-chat todo lists in the conversation workspace.",
  "enabled": true,
  "config": {
    "name": "todo",
    "summary": "Todo",
    "tags": ["todo", "planning", "workspace"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list", "add", "update", "complete", "remove", "clear"],
            "default": "list"
          },
          "title": {"type": "string"},
          "task": {"type": "string"},
          "todo_id": {"type": "string"},
          "status": {"type": "string", "enum": ["todo", "doing", "done", "blocked"]},
          "priority": {"type": "string", "enum": ["low", "normal", "high"]},
          "notes": {"type": "string"}
        }
      }
    },
    "execution": {
      "type": "rumi_function",
      "qualified_name": "defaultspack:tool_todo"
    },
    "ui": {
      "group_id": "planning",
      "group_label": "Planning",
      "composer_label": "Todo",
      "composer_icon": "check-square",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "show_completed",
          "label": "Show completed",
          "type": "toggle",
          "default": true,
          "help": "Saved visibility preference for completed todos."
        },
        {
          "id": "grouping",
          "label": "Grouping",
          "type": "select",
          "default": "status",
          "options": [
            {"value": "status", "label": "Status"},
            {"value": "priority", "label": "Priority"},
            {"value": "none", "label": "None"}
          ],
          "help": "Saved preference for organizing todo lists."
        }
      ]
    }
  }
}
