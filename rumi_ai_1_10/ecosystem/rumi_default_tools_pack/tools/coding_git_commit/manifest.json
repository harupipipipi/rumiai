{
  "id": "coding_git_commit",
  "category": "tool",
  "version": "1",
  "display_name": "Git Commit",
  "description": "Create a local git commit after approval.",
  "enabled": true,
  "config": {
    "name": "coding_git_commit",
    "summary": "Create a git commit",
    "tags": ["coding", "git", "write"],
    "ui": {
      "group_id": "coding/github/commit",
      "group_label": "Commit",
      "group_icon": "git",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {"id": "approval_policy", "label": "Approval Policy", "type": "select", "default": "prompt", "options": [{"value": "prompt", "label": "Prompt"}, {"value": "always_require", "label": "Always Require"}]},
        {"id": "default_workspace_root", "label": "Default Workspace Root", "type": "text", "default": "", "help": "Durable root used when a workspace root is not provided by the runtime."},
        {"id": "preflight_by_default", "label": "Preflight By Default", "type": "toggle", "default": true}
      ]
    },
    "tool_category": "git",
    "action_type": "commit",
    "write_action": true,
    "requires_approval": true,
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "message": {"type": "string"},
          "all_tracked": {"type": "boolean"}
        },
        "required": ["message"]
      }
    },
    "execution": {"type": "local"},
    "handler": "blocks.coding.git_commit:run"
  }
}
