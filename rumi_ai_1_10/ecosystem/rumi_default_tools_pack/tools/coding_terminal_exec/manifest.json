{
  "id": "coding_terminal_exec",
  "category": "tool",
  "version": "1",
  "display_name": "Run Command",
  "description": "Run a local workspace command with approval policy.",
  "enabled": true,
  "config": {
    "name": "coding_terminal_exec",
    "summary": "Run a workspace command",
    "tags": ["coding", "terminal", "command"],
    "ui": {
      "group_id": "coding/terminal/exec",
      "group_label": "Exec",
      "group_icon": "terminal",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {"id": "approval_policy", "label": "Approval Policy", "type": "select", "default": "prompt", "options": [{"value": "prompt", "label": "Prompt"}, {"value": "always_require", "label": "Always Require"}]},
        {"id": "default_cwd", "label": "Default CWD", "type": "text", "default": "", "help": "Durable working directory default; individual calls still provide their own command."},
        {"id": "default_timeout_seconds", "label": "Default Timeout Seconds", "type": "number", "default": 30, "min": 1, "max": 120},
        {"id": "max_output_chars", "label": "Max Output Chars", "type": "number", "default": 20000, "min": 1000, "max": 200000}
      ]
    },
    "tool_category": "shell",
    "action_type": "shell",
    "risk": "high",
    "approval_policy": "ask",
    "capability_grants": ["terminal.exec"],
    "requires_approval": true,
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "command": {"type": "string"},
          "cwd": {"type": "string"},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 120}
        },
        "required": ["command"]
      }
    },
    "execution": {"type": "rumi_function", "qualified_name": "defaultspack:coding_terminal_exec"}
  }
}
