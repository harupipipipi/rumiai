{
  "id": "browser_use",
  "category": "tool",
  "version": "1",
  "display_name": "Browser Use",
  "description": "Open URLs when requested, inspect browser/app state, bring visible apps such as Vivaldi or Chrome to the main screen, capture screenshots for vision-capable models, and move the virtual AI cursor from screenshot coordinates. Hidden-window/background control is disabled.",
  "enabled": true,
  "config": {
    "name": "browser_use",
    "summary": "ブラウザ操作。action=context で開いているアプリ/選択ウィンドウ/AIカーソルも確認できます。",
    "tags": ["browser", "vision", "screenshot", "cursor"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["session", "open_url", "context", "apps", "select_app", "show_app", "screenshot", "move", "click", "drag", "select_window", "windows", "type", "key", "scroll"],
            "default": "session"
          },
          "url": {"type": "string"},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "point": {
            "type": "array",
            "items": {"type": "number"},
            "description": "Preferred image-click coordinate as [y, x] normalized from 0 to 1000 on the latest screenshot."
          },
          "point_order": {"type": "string", "description": "Use yx for point:[y,x] (default) or xy for point:[x,y]."},
          "normalized_point": {
            "type": "array",
            "items": {"type": "number"},
            "description": "Alias for point:[y,x] in normalized 0-1000 coordinates."
          },
          "normalized_x": {"type": "number"},
          "normalized_y": {"type": "number"},
          "x1": {"type": "integer"},
          "y1": {"type": "integer"},
          "x2": {"type": "integer"},
          "y2": {"type": "integer"},
          "from_x": {"type": "integer"},
          "from_y": {"type": "integer"},
          "to_x": {"type": "integer"},
          "to_y": {"type": "integer"},
          "text": {"type": "string"},
          "key": {"type": "string"},
          "amount": {"type": "integer"},
          "target": {"type": "string"},
          "scope": {"type": "string"},
          "app": {"type": "string"},
          "application": {"type": "string"},
          "name": {"type": "string"},
          "title": {"type": "string"},
          "title_contains": {"type": "string"},
          "coordinate_space": {"type": "string", "description": "screen, window/screenshot, model_image, or normalized_1000 for [y,x] 0-1000 coordinates from the latest screenshot."},
          "physical": {"type": "boolean"},
          "virtual_only": {"type": "boolean", "description": "For click/drag, preview the marker and AI cursor without operating the real UI."},
          "focus": {"type": "boolean"},
          "method": {"type": "string"},
          "driver": {"type": "string"},
          "dry_run": {"type": "boolean"},
          "approval_token": {"type": "string"},
          "payload": {"type": "object"}
        }
      }
    },
    "execution": {
      "type": "rumi_function",
      "qualified_name": "rumi_default_tools_pack:browser_use"
    },
    "tool_category": "browser",
    "action_type": "desktop",
    "risk": "high",
    "approval_policy": "ask",
    "capability_grants": ["browser.control", "computer.control"],
    "requires_approval": true,
    "ui": {
      "group_id": "browser",
      "group_label": "Browser",
      "composer_label": "Browser Use",
      "composer_icon": "globe",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "default_target",
          "label": "Default Target",
          "type": "select",
          "default": "active_session",
          "options": [
            {"value": "active_session", "label": "Active Session"},
            {"value": "new_tab", "label": "New Tab"},
            {"value": "isolated_session", "label": "Isolated Session"}
          ],
          "help": "Default browser context for new tasks; request-specific details are supplied at call time."
        },
        {
          "id": "mode",
          "label": "Default Mode",
          "type": "select",
          "default": "inspect_first",
          "options": [
            {"value": "inspect_first", "label": "Inspect First"},
            {"value": "direct", "label": "Direct Action"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Preferred operating mode before issuing browser actions."
        },
        {
          "id": "safety",
          "label": "Safety Default",
          "type": "select",
          "default": "approval_required",
          "options": [
            {"value": "approval_required", "label": "Require Approval"},
            {"value": "dry_run_first", "label": "Dry Run First"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Durable safety preference for browser operations."
        },
        {
          "id": "quality",
          "label": "Screenshot Quality",
          "type": "select",
          "default": "standard",
          "options": [
            {"value": "compact", "label": "Compact"},
            {"value": "standard", "label": "Standard"},
            {"value": "high_detail", "label": "High Detail"}
          ],
          "help": "Default screenshot/detail preference for visual inspection."
        }
      ]
    }
  }
}
