{
  "id": "subagent",
  "category": "tool",
  "version": "1",
  "display_name": "Delegation",
  "description": "Delegate a bounded task to a child conversation and link it under the parent chat.",
  "enabled": true,
  "config": {
    "name": "subagent",
    "summary": "Delegation",
    "tags": ["agent", "subagent", "delegation"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "task": {"type": "string"},
          "title": {"type": "string"},
          "model": {"type": "string"},
          "agent_id": {"type": "string"}
        },
        "required": ["task"]
      }
    },
    "execution": {
      "type": "rumi_function",
      "qualified_name": "defaultspack:tool_subagent"
    },
    "tool_category": "agent",
    "action_type": "execute",
    "risk": "medium",
    "approval_policy": "ask",
    "capability_grants": [],
    "ui": {
      "group_id": "agent",
      "group_label": "Agent",
      "composer_label": "Delegation",
      "composer_icon": "bot",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "default_model",
          "label": "Default model",
          "type": "text",
          "default": "",
          "help": "Saved fallback model preference when a parent chat has no model."
        },
        {
          "id": "max_concurrent_subagents",
          "label": "Max concurrent delegations",
          "type": "number",
          "default": 2,
          "min": 1,
          "max": 8,
          "help": "Saved preference for delegated work fan-out."
        }
      ]
    }
  }
}
