{
  "id": "computer_use",
  "category": "tool",
  "version": "1",
  "display_name": "Computer Use",
  "description": "Capture the screen and run approved desktop actions on macOS or Windows.",
  "enabled": true,
  "config": {
    "name": "computer_use",
    "summary": "コンピューター操作",
    "tags": ["computer", "desktop", "screenshot", "approval"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["screenshot", "move", "click", "select_window", "windows", "type", "key", "scroll"],
            "default": "screenshot"
          },
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "text": {"type": "string"},
          "key": {"type": "string"},
          "amount": {"type": "integer"},
          "target": {"type": "string"},
          "app": {"type": "string"},
          "title": {"type": "string"},
          "coordinate_space": {"type": "string"},
          "physical": {"type": "boolean"},
          "focus": {"type": "boolean"},
          "dry_run": {"type": "boolean"},
          "approval_token": {"type": "string"},
          "payload": {"type": "object"}
        }
      }
    },
    "execution": {
      "type": "rumi_function",
      "qualified_name": "rumi_default_tools_pack:computer_use"
    },
    "requires_approval": true,
    "action_type": "desktop",
    "ui": {
      "group_id": "computer",
      "group_label": "Computer",
      "composer_label": "Computer Use",
      "composer_icon": "monitor",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "default_target",
          "label": "Default Target",
          "type": "select",
          "default": "primary_display",
          "options": [
            {"value": "primary_display", "label": "Primary Display"},
            {"value": "selected_window", "label": "Selected Window"},
            {"value": "active_window", "label": "Active Window"},
            {"value": "all_displays", "label": "All Displays"}
          ],
          "help": "Default desktop target for new tasks; request-specific details are supplied at call time."
        },
        {
          "id": "mode",
          "label": "Default Mode",
          "type": "select",
          "default": "inspect_first",
          "options": [
            {"value": "inspect_first", "label": "Inspect First"},
            {"value": "direct", "label": "Direct Action"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Preferred operating mode before issuing desktop actions."
        },
        {
          "id": "safety",
          "label": "Safety Default",
          "type": "select",
          "default": "approval_required",
          "options": [
            {"value": "approval_required", "label": "Require Approval"},
            {"value": "dry_run_first", "label": "Dry Run First"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Durable safety preference for desktop operations."
        },
        {
          "id": "quality",
          "label": "Screenshot Quality",
          "type": "select",
          "default": "standard",
          "options": [
            {"value": "compact", "label": "Compact"},
            {"value": "standard", "label": "Standard"},
            {"value": "high_detail", "label": "High Detail"}
          ],
          "help": "Default screenshot/detail preference for visual inspection."
        }
      ]
    }
  }
}
