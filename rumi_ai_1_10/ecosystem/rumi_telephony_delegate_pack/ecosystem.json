      },
      {
        "pack_id": "rumi_connector_gateway_pack",
        "reason": "Owns contact lookup and provider connectors."
      },
      {
        "pack_id": "rumi_meeting_intelligence_pack",
        "reason": "Owns meeting recap and action extraction after a transcript exists."
      },
      {
        "pack_id": "rumi_security_review_pack",
        "reason": "Reviews real-world action risk, fraud, and policy edge cases."
      },
      {
        "pack_id": "rumi_business_ops_pack",
        "reason": "Owns downstream business workflow execution after human approval."
      }
