{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/continuity_packet.schema.json",
  "title": "Continuity Packet",
  "description": "Agent continuity contract schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "source_pack_id",
    "run_ref",
    "created_at",
    "continuity_state",
    "resume_goal",
    "current_focus",
    "completed_work",
    "remaining_work",
    "open_questions",
    "evidence_refs",
    "handoff_targets",
    "review_state"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "run_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "continuity_state": {
      "type": "string",
      "minLength": 1
    },
    "resume_goal": {
      "type": "string",
      "minLength": 1
    },
    "current_focus": {
      "type": "string",
      "minLength": 1
    },
    "completed_work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "remaining_work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "handoff_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_state": {
      "type": "string",
      "minLength": 1
    }
  }
}
