{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/continuity_artifact_manifest.schema.json",
  "title": "Continuity Artifact Manifest",
  "description": "Agent continuity contract schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "packet_id",
    "artifact_refs",
    "artifact_roles",
    "path_or_uri_redaction_state",
    "workspace_owner",
    "persistence_owner",
    "reference_only"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "artifact_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "path_or_uri_redaction_state": {
      "type": "string",
      "enum": [
        "redacted",
        "local_ref_only",
        "opaque_ref"
      ]
    },
    "workspace_owner": {
      "const": "rumi_workspace_pack"
    },
    "persistence_owner": {
      "const": "rumi_workspace_pack"
    },
    "reference_only": {
      "const": true
    }
  }
}
