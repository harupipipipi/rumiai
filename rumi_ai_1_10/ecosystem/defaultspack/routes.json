{
  "routes": [
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/chat/conversations",
      "flow_id": "simple_chat",
      "description": "Create conversation and optionally send first message"
    },
    {
      "method": "GET",
      "path": "/api/packs/defaultspack/chat/conversations",
      "flow_id": "simple_chat",
      "description": "List conversations"
    },
    {
      "method": "GET",
      "path": "/api/packs/defaultspack/chat/conversations/{id}",
      "flow_id": "simple_chat",
      "description": "Get conversation by ID"
    },
    {
      "method": "PUT",
      "path": "/api/packs/defaultspack/chat/conversations/{id}",
      "flow_id": "simple_chat",
      "description": "Update conversation"
    },
    {
      "method": "DELETE",
      "path": "/api/packs/defaultspack/chat/conversations/{id}",
      "flow_id": "simple_chat",
      "description": "Delete conversation"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/chat/conversations/{id}/messages",
      "flow_id": "simple_chat",
      "description": "Send message to conversation"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/chat/conversations/{id}/stream",
      "flow_id": "simple_chat",
      "description": "Send message with streaming response"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/chat/conversations/{id}/export",
      "flow_id": "simple_chat",
      "description": "Export conversation"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/agent/execute",
      "flow_id": "agent_chat",
      "description": "Execute agent task"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/agent/{id}/approve",
      "flow_id": "agent_chat",
      "description": "Approve agent action"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/agent/{id}/reject",
      "flow_id": "agent_chat",
      "description": "Reject agent action"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/agent/{id}/cancel",
      "flow_id": "agent_chat",
      "description": "Cancel agent execution"
    },
    {
      "method": "GET",
      "path": "/api/packs/defaultspack/agent/{id}/status",
      "flow_id": "agent_chat",
      "description": "Get agent execution status"
    },
    {
      "method": "POST",
      "path": "/api/packs/defaultspack/planning/execute",
      "flow_id": "planning_agent",
      "description": "Execute planning agent"
    },
    {
      "method": "GET",
      "path": "/api/packs/defaultspack/planning/{id}/status",
      "flow_id": "planning_agent",
      "description": "Get planning agent status"
    },
    {
      "method": "GET",
      "path": "/api/capabilities",
      "flow_id": "transport_direct",
      "description": "List defaultspack local-first capability manifests"
    },
    {
      "method": "GET",
      "path": "/api/capabilities/{id}",
      "flow_id": "transport_direct",
      "description": "Get one defaultspack capability manifest"
    },
    {
      "method": "POST",
      "path": "/api/coding/files/read",
      "flow_id": "transport_direct",
      "description": "Read a workspace file"
    },
    {
      "method": "POST",
      "path": "/api/coding/files/write",
      "flow_id": "transport_direct",
      "description": "Write a workspace file with approval policy metadata"
    },
    {
      "method": "POST",
      "path": "/api/coding/terminal/exec",
      "flow_id": "transport_direct",
      "description": "Execute a local terminal command"
    },
    {
      "method": "GET",
      "path": "/api/coding/git/status",
      "flow_id": "transport_direct",
      "description": "Read git status"
    },
    {
      "method": "GET",
      "path": "/api/coding/git/diff",
      "flow_id": "transport_direct",
      "description": "Read git diff"
    },
    {
      "method": "POST",
      "path": "/api/research/local-search",
      "flow_id": "transport_direct",
      "description": "Search local knowledge as research sources"
    },
    {
      "method": "POST",
      "path": "/api/research/report",
      "flow_id": "transport_direct",
      "description": "Generate a local-first research report artifact"
    }
  ]
}
