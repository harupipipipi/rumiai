{
  "function_id": "tool_web_search",
  "description": "Run the default web search tool.",
  "tags": [
    "tool",
    "research"
  ],
  "risk": "medium",
  "requires": [
    "tool.web.search"
  ],
  "caller_requires": [],
  "host_execution": false,
  "calling_convention": "subprocess",
  "entrypoint": "main.py:run",
  "vocab_aliases": [
    "defaults.tool.web_search",
    "defaultspack.tool.web_search",
    "defaults.tool.web.search",
    "defaultspack.tool.web.search"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {"type": "string"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 20},
      "allow_network": {"type": "boolean"},
      "domains": {
        "oneOf": [
          {"type": "array", "items": {"type": "string"}},
          {"type": "string"}
        ]
      },
      "official_only": {"type": "boolean"},
      "fetch_pages": {"type": "boolean"},
      "max_chars": {
        "type": "integer",
        "minimum": 1,
        "description": "Optional character budget for source excerpts."
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1,
        "description": "Optional approximate token budget for source excerpts."
      }
    },
    "required": ["query"],
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "data": {},
      "error": {
        "type": "object"
      }
    }
  },
  "extensions": {
    "defaultspack": {
      "block_module": null,
      "default_args": {}
    }
  }
}
