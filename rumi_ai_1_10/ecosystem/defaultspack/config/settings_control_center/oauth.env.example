# Rumi official OAuth secrets are never committed to OSS.
# Official hosted app config lives only in hosted infrastructure.

RUMI_OFFICIAL_APP_AVAILABLE=false
RUMI_OFFICIAL_APP_DOWNLOAD_URL=https://rumi.ai/download
RUMI_OFFICIAL_OAUTH_BROKER_URL=

# Self-host OAuth examples. Fill these only in your own deployment.
RUMI_CLOUDFLARE_OAUTH_CLIENT_ID=
RUMI_CLOUDFLARE_OAUTH_CLIENT_SECRET=
RUMI_CLOUDFLARE_OAUTH_SCOPES=
RUMI_CLOUDFLARE_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/api/ai/oauth/cloudflare/callback
# Optional direct-token fallback when you already have a Cloudflare OAuth access token.
RUMI_CLOUDFLARE_OAUTH_ACCESS_TOKEN=
RUMI_CLOUDFLARE_OAUTH_REFRESH_TOKEN=

# Optional Sandbox Bridge endpoint for Cloudflare Containers-backed runtime tools.
# RUMI_CLOUDFLARE_SANDBOX_API_KEY is the Bridge Bearer secret, not a Cloudflare API token.
RUMI_CLOUDFLARE_SANDBOX_BRIDGE_URL=
RUMI_CLOUDFLARE_SANDBOX_API_KEY=

# Stable phone-to-PC access uses Cloudflare Tunnel, not a pages.dev URL.
RUMI_CLOUDFLARE_PC_TUNNEL_HOSTNAME=
RUMI_CLOUDFLARE_PC_TUNNEL_ORIGIN_URL=http://127.0.0.1:8765
RUMI_CLOUDFLARE_PC_TUNNEL_CONFIG=

# Optional Worker that forwards PC-bound defaultspack tool calls through the
# named Tunnel above. These are bridge secrets/config, not Cloudflare API tokens.
RUMI_CLOUDFLARE_PC_TOOL_BRIDGE_URL=
RUMI_PC_TOOL_BRIDGE_TOKEN=
RUMI_PC_RUNTIME_BEARER=
RUMI_PC_ORIGIN=
RUMI_PC_TOOL_BRIDGE_ALLOWED_ORIGIN=

RUMI_GOOGLE_OAUTH_CLIENT_ID=
RUMI_GOOGLE_OAUTH_CLIENT_SECRET=
RUMI_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/api/ai/oauth/google/callback

# Codex App Server auth is separate from RUMI_CODEX_ACCESS_TOKEN.
# Prefer *_FILE paths when launching or probing App Server endpoints.
RUMI_CODEX_APP_SERVER_WS_TOKEN=
RUMI_CODEX_APP_SERVER_WS_TOKEN_FILE=
RUMI_CODEX_APP_SERVER_SHARED_SECRET=
RUMI_CODEX_APP_SERVER_SHARED_SECRET_FILE=

# Required for local encrypted credential store.
RUMI_CREDENTIAL_FERNET_KEY=
