{
  "schema": "rumi.connection.provider.v1",
  "provider_id": "cloudflare",
  "display_name": {
    "en": "Cloudflare",
    "ja": "Cloudflare"
  },
  "description": {
    "en": "Continue Rumi tasks in your Cloudflare account when this computer is offline.",
    "ja": "PCがオフラインでもCloudflareアカウントでRumiの作業を継続します。"
  },
  "icon": "cloudflare",
  "service_kind": "cloud",
  "auth": {
    "type": "oauth2",
    "template": "generic_oauth2_pkce",
    "token_import_supported": true,
    "official_broker_supported": true,
    "self_host_client_supported": true,
    "pkce_supported": true,
    "oauth": {
      "authorization_url": "https://dash.cloudflare.com/oauth2/auth",
      "token_url": "https://dash.cloudflare.com/oauth2/token",
      "revoke_url": "https://dash.cloudflare.com/oauth2/revoke",
      "userinfo_url": "https://dash.cloudflare.com/oauth2/userinfo",
      "default_scopes": [],
      "pkce_supported": true,
      "token_endpoint_auth_method": "client_secret_post"
    }
  },
  "scope_presets": [
    {
      "id": "account_read",
      "label": "Read account metadata",
      "scopes": ["account:read", "user:read"]
    }
  ],
  "capabilities": [
    {
      "id": "cloudflare.account.read",
      "displayName": {
        "en": "Read account metadata",
        "ja": "アカウント情報を読む"
      },
      "description": {
        "en": "Select the account Rumi should use.",
        "ja": "Rumiが使用するアカウントを選びます。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.runner.deploy",
      "displayName": {
        "en": "Deploy Rumi runner",
        "ja": "Rumi runnerを配置"
      },
      "description": {
        "en": "Create/update runner resources for cloud continuation.",
        "ja": "クラウド継続用runnerリソースを作成/更新します。"
      },
      "risk": "medium"
    }
  ],
  "scope_to_capability": [
    {
      "scopes": ["account:read"],
      "capabilities": ["cloudflare.account.read"]
    },
    {
      "scopes": [
        "workers:write",
        "workers_scripts:edit",
        "d1:write",
        "r2:write",
        "queues:write",
        "workflows:write"
      ],
      "capabilities": ["cloudflare.runner.deploy"]
    }
  ],
  "adapter": {
    "python": "ecosystem.defaultspack.domain.connections.cloudflare:CloudflareConnectionAdapter",
    "sdk_optional": true
  },
  "settings": {
    "section": "accounts_connections",
    "priority": 30,
    "recommended": true
  },
  "metadata": {
    "scope_note": "Configure least-privilege Cloudflare OAuth scopes for the exact runner resources used by the implementation. Do not request broad account permissions by default.",
    "self_host_env": [
      "RUMI_CLOUDFLARE_OAUTH_CLIENT_ID",
      "RUMI_CLOUDFLARE_OAUTH_CLIENT_SECRET",
      "RUMI_CLOUDFLARE_OAUTH_SCOPES",
      "RUMI_CLOUDFLARE_OAUTH_REDIRECT_URI"
    ],
    "direct_token_env": [
      "RUMI_CLOUDFLARE_OAUTH_ACCESS_TOKEN",
      "RUMI_CLOUDFLARE_OAUTH_REFRESH_TOKEN"
    ]
  }
}
