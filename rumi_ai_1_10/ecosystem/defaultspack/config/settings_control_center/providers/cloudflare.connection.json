{
  "schema": "rumi.connection.provider.v1",
  "provider_id": "cloudflare",
  "display_name": {
    "en": "Cloudflare",
    "ja": "Cloudflare"
  },
  "description": {
    "en": "Continue Rumi tasks in your Cloudflare account when this computer is offline.",
    "ja": "PCがオフラインでもCloudflareアカウントでRumiの作業を継続します。"
  },
  "icon": "cloudflare",
  "service_kind": "cloud",
  "auth": {
    "type": "oauth2",
    "template": "generic_oauth2_pkce",
    "token_import_supported": true,
    "official_broker_supported": true,
    "self_host_client_supported": true,
    "pkce_supported": true,
    "oauth": {
      "authorization_url": "https://dash.cloudflare.com/oauth2/auth",
      "token_url": "https://dash.cloudflare.com/oauth2/token",
      "revoke_url": "https://dash.cloudflare.com/oauth2/revoke",
      "userinfo_url": "https://dash.cloudflare.com/oauth2/userinfo",
      "default_scopes": [],
      "pkce_supported": true,
      "token_endpoint_auth_method": "client_secret_post"
    }
  },
  "scope_presets": [
    {
      "id": "account_read",
      "label": "Read account metadata",
      "scopes": ["account:read", "user:read"]
    }
  ],
  "capabilities": [
    {
      "id": "cloudflare.account.read",
      "displayName": {
        "en": "Read account metadata",
        "ja": "アカウント情報を読む"
      },
      "description": {
        "en": "Select the account Rumi should use.",
        "ja": "Rumiが使用するアカウントを選びます。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.pages.project.read",
      "displayName": {
        "en": "Read Pages projects",
        "ja": "Pages projectを読む"
      },
      "description": {
        "en": "List and inspect Cloudflare Pages projects.",
        "ja": "Cloudflare Pages projectを一覧・確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.pages.project.write",
      "displayName": {
        "en": "Write Pages projects",
        "ja": "Pages projectを書き込む"
      },
      "description": {
        "en": "Create, update, and delete Cloudflare Pages projects.",
        "ja": "Cloudflare Pages projectを作成・更新・削除します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.pages.deployment.read",
      "displayName": {
        "en": "Read Pages deployments",
        "ja": "Pages deploymentを読む"
      },
      "description": {
        "en": "List and inspect Cloudflare Pages deployments.",
        "ja": "Cloudflare Pages deploymentを一覧・確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.pages.deployment.write",
      "displayName": {
        "en": "Write Pages deployments",
        "ja": "Pages deploymentを書き込む"
      },
      "description": {
        "en": "Create and delete Cloudflare Pages deployments.",
        "ja": "Cloudflare Pages deploymentを作成・削除します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.worker.read",
      "displayName": {
        "en": "Read Workers",
        "ja": "Workersを読む"
      },
      "description": {
        "en": "Inspect Cloudflare Worker resources.",
        "ja": "Cloudflare Workerリソースを確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.worker.write",
      "displayName": {
        "en": "Write Workers",
        "ja": "Workersを書き込む"
      },
      "description": {
        "en": "Create or update Cloudflare Worker resources.",
        "ja": "Cloudflare Workerリソースを作成・更新します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.r2.read",
      "displayName": {
        "en": "Read R2",
        "ja": "R2を読む"
      },
      "description": {
        "en": "Inspect Cloudflare R2 resources.",
        "ja": "Cloudflare R2リソースを確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.r2.write",
      "displayName": {
        "en": "Write R2",
        "ja": "R2を書き込む"
      },
      "description": {
        "en": "Create or update Cloudflare R2 resources.",
        "ja": "Cloudflare R2リソースを作成・更新します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.d1.read",
      "displayName": {
        "en": "Read D1",
        "ja": "D1を読む"
      },
      "description": {
        "en": "Inspect Cloudflare D1 resources.",
        "ja": "Cloudflare D1リソースを確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.d1.write",
      "displayName": {
        "en": "Write D1",
        "ja": "D1を書き込む"
      },
      "description": {
        "en": "Create or update Cloudflare D1 resources.",
        "ja": "Cloudflare D1リソースを作成・更新します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.queue.read",
      "displayName": {
        "en": "Read Queues",
        "ja": "Queuesを読む"
      },
      "description": {
        "en": "Inspect Cloudflare Queues resources.",
        "ja": "Cloudflare Queuesリソースを確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.queue.write",
      "displayName": {
        "en": "Write Queues",
        "ja": "Queuesを書き込む"
      },
      "description": {
        "en": "Create or update Cloudflare Queues resources.",
        "ja": "Cloudflare Queuesリソースを作成・更新します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.workflow.read",
      "displayName": {
        "en": "Read Workflows",
        "ja": "Workflowsを読む"
      },
      "description": {
        "en": "Inspect Cloudflare Workflows resources.",
        "ja": "Cloudflare Workflowsリソースを確認します。"
      },
      "risk": "low"
    },
    {
      "id": "cloudflare.workflow.write",
      "displayName": {
        "en": "Write Workflows",
        "ja": "Workflowsを書き込む"
      },
      "description": {
        "en": "Create or update Cloudflare Workflows resources.",
        "ja": "Cloudflare Workflowsリソースを作成・更新します。"
      },
      "risk": "high"
    },
    {
      "id": "cloudflare.runner.deploy",
      "displayName": {
        "en": "Deploy Rumi runner",
        "ja": "Rumi runnerを配置"
      },
      "description": {
        "en": "Create/update runner resources for cloud continuation.",
        "ja": "クラウド継続用runnerリソースを作成/更新します。"
      },
      "risk": "high"
    }
  ],
  "scope_to_capability": [
    {
      "credential_kinds": ["oauth2_token"],
      "capabilities": ["cloudflare.account.read"]
    },
    {
      "scopes": ["account:read"],
      "capabilities": ["cloudflare.account.read"]
    },
    {
      "scopes": ["pages:read"],
      "capabilities": ["cloudflare.pages.project.read", "cloudflare.pages.deployment.read"]
    },
    {
      "scopes": ["pages:write"],
      "capabilities": [
        "cloudflare.pages.project.read",
        "cloudflare.pages.project.write",
        "cloudflare.pages.deployment.read",
        "cloudflare.pages.deployment.write"
      ]
    },
    {
      "scopes": ["workers:read", "workers_scripts:read"],
      "capabilities": ["cloudflare.worker.read"]
    },
    {
      "scopes": ["workers:write", "workers_scripts:edit"],
      "capabilities": ["cloudflare.worker.read", "cloudflare.worker.write"]
    },
    {
      "scopes": ["d1:read"],
      "capabilities": ["cloudflare.d1.read"]
    },
    {
      "scopes": ["d1:write"],
      "capabilities": ["cloudflare.d1.read", "cloudflare.d1.write"]
    },
    {
      "scopes": ["r2:read"],
      "capabilities": ["cloudflare.r2.read"]
    },
    {
      "scopes": ["r2:write"],
      "capabilities": ["cloudflare.r2.read", "cloudflare.r2.write"]
    },
    {
      "scopes": ["queues:read"],
      "capabilities": ["cloudflare.queue.read"]
    },
    {
      "scopes": ["queues:write"],
      "capabilities": ["cloudflare.queue.read", "cloudflare.queue.write"]
    },
    {
      "scopes": ["workflows:read"],
      "capabilities": ["cloudflare.workflow.read"]
    },
    {
      "scopes": ["workflows:write"],
      "capabilities": ["cloudflare.workflow.read", "cloudflare.workflow.write"]
    },
    {
      "scopes": [
        "workers:write",
        "workers_scripts:edit",
        "pages:write",
        "d1:write",
        "r2:write",
        "queues:write",
        "workflows:write"
      ],
      "match": "all",
      "capabilities": ["cloudflare.runner.deploy"]
    }
  ],
  "adapter": {
    "python": "ecosystem.defaultspack.domain.connections.cloudflare:CloudflareConnectionAdapter",
    "sdk_optional": true
  },
  "settings": {
    "section": "accounts_connections",
    "priority": 30,
    "recommended": true
  },
  "metadata": {
    "scope_note": "Configure least-privilege Cloudflare OAuth scopes for the exact runner resources used by the implementation. Do not request broad account permissions by default.",
    "self_host_env": [
      "RUMI_CLOUDFLARE_OAUTH_CLIENT_ID",
      "RUMI_CLOUDFLARE_OAUTH_CLIENT_SECRET",
      "RUMI_CLOUDFLARE_OAUTH_SCOPES",
      "RUMI_CLOUDFLARE_OAUTH_REDIRECT_URI"
    ],
    "direct_token_env": [
      "RUMI_CLOUDFLARE_OAUTH_ACCESS_TOKEN",
      "RUMI_CLOUDFLARE_OAUTH_REFRESH_TOKEN",
      "CLOUDFLARE_API_TOKEN",
      "CF_API_TOKEN"
    ],
    "optional_context_env": [
      "RUMI_CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_ACCOUNT_ID",
      "RUMI_CLOUDFLARE_ZONE_ID",
      "CLOUDFLARE_ZONE_ID"
    ]
  }
}
