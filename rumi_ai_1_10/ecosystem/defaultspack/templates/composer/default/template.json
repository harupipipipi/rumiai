{
  "id": "rumi.composer.default",
  "kind": "frontend",
  "version": "1.0.0",
  "status": "active",
  "trust_level": "builtin",
  "capabilities": {
    "provides": [
      "rumi.composer.default",
      "rumi.composer.context_txt",
      "rumi.context.materialize_txt"
    ],
    "requires": [],
    "permissions": []
  },
  "metadata": {
    "title": "Default Composer",
    "template_kind": "frontend_template",
    "local_first": true,
    "description": "Declarative metadata for the default composer input surface and context materialization command."
  },
  "pieces": [
    {
      "id": "composer_shell_region",
      "kind": "shell_region",
      "order": 50,
      "region": {
        "id": "composer",
        "part_id": "ai_chat",
        "renderer": "composer",
        "slot": "bottom",
        "order": 50,
        "enabled": true
      }
    },
    {
      "id": "composer_shell_renderer",
      "kind": "shell_renderer",
      "order": 51,
      "renderer": {
        "id": "composer",
        "component": "Composer",
        "regions": [
          "composer"
        ],
        "fallback": "hidden"
      }
    },
    {
      "id": "default_composer_input",
      "kind": "composer_input",
      "order": 52,
      "input": {
        "id": "default_composer",
        "region_id": "composer",
        "renderer": "composer",
        "part_id": "ai_chat",
        "surface": "chat",
        "enabled": true,
        "placeholder": "メッセージを入力... /context text で会話をTXT化",
        "help": "Template-composed composer: slash commands, mentions, files, voice, and optional context TXT materialization.",
        "accepted_modalities": [
          "text",
          "files",
          "images",
          "voice"
        ],
        "feature_flags": {
          "slash_commands": true,
          "at_mentions": true,
          "tool_mentions": true,
          "file_attachments": true,
          "voice_input": true,
          "context_preview": true
        },
        "commands": [
          "context_txt"
        ],
        "context_policy": "materialize_txt"
      }
    },
    {
      "id": "context_txt_command",
      "kind": "composer_command",
      "order": 53,
      "command": {
        "id": "context_txt",
        "name": "context_txt",
        "aliases": [
          "context text",
          "context-txt",
          "context_text",
          "long context txt",
          "long-context-txt",
          "long_context_txt"
        ],
        "label": "Context TXT",
        "description": "Materialize the current conversation context as text.",
        "category": "chat",
        "visibility": "default",
        "risk": "medium",
        "modes": [
          "chat",
          "coding",
          "agent"
        ],
        "args": [
          {
            "name": "scope",
            "type": "string",
            "required": false
          }
        ],
        "execution": {
          "type": "pack_block",
          "qualified_name": "defaultspack:chat.materialize_context",
          "mode": "materialize_txt"
        }
      }
    },
    {
      "id": "materialize_txt_policy",
      "kind": "context_policy",
      "order": 54,
      "policy": {
        "id": "materialize_txt",
        "mode": "materialize_txt",
        "format": "text/plain",
        "filename": "context.txt",
        "command_id": "context_txt",
        "source": "conversation_context",
        "delivery": "composer_command"
      }
    }
  ]
}
