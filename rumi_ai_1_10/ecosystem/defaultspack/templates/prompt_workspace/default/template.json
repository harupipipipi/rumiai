{
  "schema_version": 1,
  "id": "rumi.prompt_workspace.default",
  "kind": "composite",
  "version": "1.0.0",
  "status": "active",
  "trust_level": "builtin",
  "dependencies": [
    {
      "id": "rumi.model_selector.default",
      "version": ">=1.0,<2",
      "optional": true
    },
    {
      "id": "rumi.backend.prompt_compaction.default",
      "version": ">=1.0,<2",
      "optional": true
    }
  ],
  "capabilities": {
    "provides": [
      "rumi.prompt_workspace",
      "rumi.prompt.command_center",
      "rumi.prompt.studio",
      "rumi.prompt.trace",
      "rumi.prompt.override",
      "rumi.prompt.test_bench"
    ],
    "requires": [],
    "permissions": [
      "prompt.inspect",
      "prompt.manage"
    ]
  },
  "metadata": {
    "title": "Prompt Workspace",
    "template_kind": "fullstack_template",
    "local_first": true,
    "description": "Declarative Prompt Studio, Command Center, trace, toggle, override, and test-bench surface."
  },
  "pieces": [
    {
      "id": "prompt_studio_page",
      "kind": "frontend_component",
      "order": 80,
      "part_id": "prompt_studio",
      "component": "PromptStudio",
      "renderer": "prompt_studio",
      "route": "/prompts",
      "requires": [
        "rumi.prompt.studio"
      ],
      "optional": [
        "rumi.model_selector",
        "rumi.prompt_compaction"
      ]
    },
    {
      "id": "prompt_command_center_component",
      "kind": "frontend_component",
      "order": 81,
      "part_id": "prompt_command_center",
      "component": "PromptCommandCenter",
      "renderer": "prompt_command_center",
      "requires": [
        "rumi.prompt.command_center"
      ]
    },
    {
      "id": "prompt_workspace_sidebar",
      "kind": "sidebar_item",
      "order": 82,
      "label": "Prompt Workspace",
      "category": "system",
      "description": "Inspect, test, override, and roll back prompts that affect model input.",
      "route": "/prompts",
      "href": "/prompts",
      "tags": [
        "prompt",
        "studio",
        "workspace"
      ],
      "panel": {
        "kind": "link",
        "title": "Prompt Workspace",
        "route": "/prompts"
      }
    },
    {
      "id": "prompt_command_center_region",
      "kind": "shell_region",
      "order": 83,
      "region": {
        "id": "prompt_command_center",
        "part_id": "ai_chat",
        "renderer": "prompt_command_center",
        "slot": "right",
        "order": 70,
        "enabled": true
      }
    },
    {
      "id": "prompt_command_center_renderer",
      "kind": "shell_renderer",
      "order": 84,
      "renderer": {
        "id": "prompt_command_center",
        "component": "PromptCommandCenter",
        "regions": [
          "prompt_command_center"
        ],
        "fallback": "hidden"
      }
    },
    {
      "id": "prompt_workspace_read_permission",
      "kind": "permission",
      "order": 85,
      "permission_id": "prompt.inspect",
      "scope": "prompt",
      "reason": "Prompt Workspace reads prompt traces, active prompt summaries, source chains, and safety metadata."
    },
    {
      "id": "prompt_workspace_manage_permission",
      "kind": "permission",
      "order": 86,
      "permission_id": "prompt.manage",
      "scope": "prompt",
      "reason": "Prompt Workspace may write profile overrides, disabled_edges toggles, and version rollbacks through existing prompt blocks."
    },
    {
      "id": "prompt_workspace_index_route",
      "kind": "function",
      "order": 90,
      "role": "data_source",
      "data_source": "prompt_workspace_index",
      "function_id": "prompt_editor_load",
      "handler_ref": "blocks.prompt.editor_load:run",
      "route_path": "/api/prompts",
      "method": "GET",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_active_route",
      "kind": "function",
      "order": 91,
      "role": "data_source",
      "data_source": "prompt_active",
      "function_id": "prompt_active",
      "handler_ref": "blocks.prompt.active:run",
      "route_path": "/api/prompts/active",
      "method": "GET",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_trace_list_route",
      "kind": "function",
      "order": 92,
      "role": "data_source",
      "data_source": "prompt_trace_list",
      "function_id": "prompt_trace_list",
      "handler_ref": "blocks.prompt.trace:run",
      "route_path": "/api/prompts/traces",
      "method": "GET",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_trace_detail_route",
      "kind": "function",
      "order": 93,
      "role": "data_source",
      "data_source": "prompt_trace_get",
      "function_id": "prompt_trace_get",
      "handler_ref": "blocks.prompt.trace:run",
      "route_path": "/api/prompts/traces/{trace_id}",
      "method": "GET",
      "path_inject": {
        "trace_id": "trace_id"
      },
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_toggle_route",
      "kind": "function",
      "order": 94,
      "role": "action",
      "action_id": "prompt_toggle",
      "function_id": "prompt_toggle",
      "handler_ref": "blocks.prompt.toggle:run",
      "route_path": "/api/prompts/toggle",
      "method": "POST",
      "risk": "medium",
      "requires": [
        "prompt.manage"
      ]
    },
    {
      "id": "prompt_workspace_preview_toggle_route",
      "kind": "function",
      "order": 95,
      "role": "data_source",
      "data_source": "prompt_preview_toggle",
      "function_id": "prompt_preview_toggle",
      "handler_ref": "blocks.prompt.preview_toggle:run",
      "route_path": "/api/prompts/preview-toggle",
      "method": "POST",
      "default_args": {
        "preview": true
      },
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_editor_route",
      "kind": "function",
      "order": 96,
      "role": "data_source",
      "data_source": "prompt_editor_load",
      "function_id": "prompt_editor_load",
      "handler_ref": "blocks.prompt.editor_load:run",
      "route_path": "/api/prompts/editor",
      "method": "GET",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_save_route",
      "kind": "function",
      "order": 97,
      "role": "action",
      "action_id": "prompt_editor_save",
      "function_id": "prompt_editor_save",
      "handler_ref": "blocks.prompt.editor:run",
      "route_path": "/api/prompts/editor/save",
      "method": "POST",
      "default_args": {
        "action": "save"
      },
      "risk": "medium",
      "requires": [
        "prompt.manage"
      ]
    },
    {
      "id": "prompt_workspace_override_route",
      "kind": "function",
      "order": 98,
      "role": "action",
      "action_id": "prompt_create_override",
      "function_id": "prompt_create_override",
      "handler_ref": "blocks.prompt.editor:run",
      "route_path": "/api/prompts/override",
      "method": "POST",
      "default_args": {
        "action": "override"
      },
      "risk": "medium",
      "requires": [
        "prompt.manage"
      ]
    },
    {
      "id": "prompt_workspace_diff_route",
      "kind": "function",
      "order": 99,
      "role": "data_source",
      "data_source": "prompt_diff",
      "function_id": "prompt_diff",
      "handler_ref": "blocks.prompt.diff:run",
      "route_path": "/api/prompts/diff",
      "method": "POST",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_test_route",
      "kind": "function",
      "order": 100,
      "role": "data_source",
      "data_source": "prompt_test",
      "function_id": "prompt_test",
      "handler_ref": "blocks.prompt.test:run",
      "route_path": "/api/prompts/test",
      "method": "POST",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_versions_route",
      "kind": "function",
      "order": 101,
      "role": "data_source",
      "data_source": "prompt_versions",
      "function_id": "prompt_versions",
      "handler_ref": "blocks.prompt.versions:run",
      "route_path": "/api/prompts/{name}/versions",
      "method": "GET",
      "path_inject": {
        "name": "name"
      },
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_rollback_route",
      "kind": "function",
      "order": 102,
      "role": "action",
      "action_id": "prompt_rollback",
      "function_id": "prompt_rollback",
      "handler_ref": "blocks.prompt.rollback:run",
      "route_path": "/api/prompts/{name}/rollback",
      "method": "POST",
      "path_inject": {
        "name": "name"
      },
      "risk": "medium",
      "requires": [
        "prompt.manage"
      ]
    },
    {
      "id": "prompt_workspace_lint_route",
      "kind": "function",
      "order": 103,
      "role": "data_source",
      "data_source": "prompt_lint_prompt",
      "function_id": "prompt_lint_prompt",
      "handler_ref": "blocks.prompt.lint_prompt:run",
      "route_path": "/api/prompts/lint",
      "method": "POST",
      "risk": "low",
      "requires": []
    },
    {
      "id": "prompt_workspace_compact_api_route",
      "kind": "api_route",
      "order": 104,
      "method": "POST",
      "path": "/api/prompts/compact",
      "function_id": "compact_prompt",
      "capability": "rumi.prompt_compaction",
      "owner_template": "rumi.backend.prompt_compaction.default"
    },
    {
      "id": "prompt_workspace_api_route_contract",
      "kind": "test_contract",
      "order": 120,
      "contract_id": "defaultspack.template.prompt_workspace.catalog",
      "assertions": [
        {
          "type": "template_projectable",
          "template_id": "rumi.prompt_workspace.default"
        },
        {
          "type": "catalog_contains",
          "bucket": "component_bindings",
          "match": {
            "part_id": "prompt_studio",
            "component": "PromptStudio"
          }
        },
        {
          "type": "catalog_contains",
          "bucket": "sidebar_items",
          "match": {
            "id": "prompt_workspace_sidebar"
          }
        },
        {
          "type": "catalog_contains",
          "bucket": "shell_regions",
          "match": {
            "id": "prompt_command_center"
          }
        },
        {
          "type": "catalog_contains",
          "bucket": "data_sources",
          "match": {
            "data_source": "prompt_editor_load"
          }
        },
        {
          "type": "catalog_contains",
          "bucket": "actions",
          "match": {
            "action_id": "prompt_editor_save"
          }
        },
        {
          "type": "catalog_contains",
          "bucket": "api_routes",
          "match": {
            "method": "POST",
            "path": "/api/prompts/compact"
          }
        },
        {
          "type": "route_resolves",
          "method": "GET",
          "path": "/api/prompts/editor"
        },
        {
          "type": "route_resolves",
          "method": "POST",
          "path": "/api/prompts/test"
        },
        {
          "type": "route_resolves",
          "method": "GET",
          "path": "/api/prompts/{name}/versions"
        },
        {
          "type": "function_registered",
          "function_id": "prompt_editor_load"
        },
        {
          "type": "function_registered",
          "function_id": "prompt_test"
        },
        {
          "type": "function_registered",
          "function_id": "prompt_toggle"
        },
        {
          "type": "function_registered",
          "function_id": "prompt_editor_save"
        },
        {
          "type": "function_registered",
          "function_id": "prompt_versions"
        },
        {
          "type": "function_registered",
          "function_id": "prompt_rollback"
        },
        {
          "type": "permission_declared",
          "permission_id": "prompt.inspect"
        },
        {
          "type": "permission_declared",
          "permission_id": "prompt.manage"
        }
      ]
    }
  ]
}
