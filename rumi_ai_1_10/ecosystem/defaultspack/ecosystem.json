{
  "pack_id": "defaultspack",
  "pack_identity": "rumi:ecosystem/defaultspack",
  "version": "2.0.0",
  "vocabulary": {
    "types": [
      "chat",
      "agent",
      "coding",
      "ai_client",
      "tool",
      "prompt",
      "memory",
      "knowledge",
      "media",
      "frontend",
      "dev"
    ]
  },
  "components": {
    "chat": {
      "type": "chat",
      "id": "chat",
      "path": "blocks/chat",
      "connectivity": {
        "provides": [
          "defaults.chat.create_conversation",
          "defaults.chat.get_conversation",
          "defaults.chat.list_conversations",
          "defaults.chat.update_conversation",
          "defaults.chat.delete_conversation",
          "defaults.chat.export_conversation",
          "defaults.chat.send",
          "defaults.chat.stream",
          "defaults.chat.add_message",
          "defaults.chat.get_message",
          "defaults.chat.update_message",
          "defaults.chat.delete_message",
          "defaults.chat.branch",
          "defaults.chat.search",
          "defaults.chat.stop",
          "defaults.chat.regenerate",
          "defaults.chat.summarize_and_trim",
          "defaults.chat.auto_trim"
        ]
      }
    },
    "agent": {
      "type": "agent",
      "id": "agent",
      "path": "blocks/agent",
      "connectivity": {
        "provides": [
          "defaults.agent.execute",
          "defaults.agent.approve",
          "defaults.agent.reject",
          "defaults.agent.cancel",
          "defaults.agent.status",
          "defaults.agent.plan",
          "defaults.agent.add_instruction",
          "defaults.agent.multi_execute",
          "defaults.agent.multi_status",
          "defaults.agent.multi_message"
        ]
      }
    },
    "coding": {
      "type": "coding",
      "id": "coding",
      "path": "blocks/coding",
      "connectivity": {
        "provides": [
          "defaults.coding.file_read",
          "defaults.coding.file_write",
          "defaults.coding.file_create",
          "defaults.coding.file_delete",
          "defaults.coding.file_search",
          "defaults.coding.file_list",
          "defaults.coding.terminal_exec",
          "defaults.coding.terminal_stream",
          "defaults.coding.git_status",
          "defaults.coding.git_diff",
          "defaults.coding.git_commit",
          "defaults.coding.git_push"
        ]
      }
    },
    "ai_client": {
      "type": "ai_client",
      "id": "ai_client",
      "path": "blocks/ai",
      "connectivity": {
        "provides": [
          "defaults.ai.complete",
          "defaults.ai.stream",
          "defaults.ai.models",
          "defaults.ai.providers",
          "defaults.ai.embed",
          "defaults.ai.image_gen",
          "defaults.ai.image_analyze",
          "defaults.ai.transcribe",
          "defaults.ai.tts"
        ]
      }
    },
    "tool": {
      "type": "tool",
      "id": "tool",
      "path": "blocks/tool",
      "connectivity": {
        "provides": [
          "defaults.tool.invoke",
          "defaults.tool.list",
          "defaults.tool.schema",
          "defaults.tool.mcp_connect",
          "defaults.tool.mcp_list",
          "defaults.tool.create",
          "defaults.tool.update",
          "defaults.tool.delete",
          "defaults.tool.export",
          "defaults.tool.consent_check",
          "defaults.tool.consent_confirm"
        ]
      }
    },
    "prompt": {
      "type": "prompt",
      "id": "prompt",
      "path": "blocks/prompt",
      "connectivity": {
        "provides": [
          "defaults.prompt.render",
          "defaults.prompt.list",
          "defaults.prompt.create",
          "defaults.prompt.system",
          "defaults.prompt.update",
          "defaults.prompt.delete",
          "defaults.prompt.convert"
        ]
      }
    },
    "memory": {
      "type": "memory",
      "id": "memory",
      "path": "blocks/memory",
      "connectivity": {
        "provides": [
          "defaults.memory.store",
          "defaults.memory.recall",
          "defaults.memory.project_context",
          "defaults.memory.vector_store",
          "defaults.memory.vector_query"
        ]
      }
    },
    "knowledge": {
      "type": "knowledge",
      "id": "knowledge",
      "path": "blocks/knowledge",
      "connectivity": {
        "provides": [
          "defaults.knowledge.create",
          "defaults.knowledge.get",
          "defaults.knowledge.list",
          "defaults.knowledge.search",
          "defaults.knowledge.update",
          "defaults.knowledge.delete"
        ]
      }
    },
    "media": {
      "type": "media",
      "id": "media",
      "path": "blocks/media",
      "connectivity": {
        "provides": [
          "defaults.media.image_read",
          "defaults.media.image_transform",
          "defaults.media.doc_parse",
          "defaults.media.clipboard_read",
          "defaults.media.clipboard_write",
          "defaults.media.screenshot"
        ]
      }
    },
    "frontend": {
      "type": "frontend",
      "id": "frontend",
      "path": "blocks/frontend",
      "connectivity": {
        "provides": [
          "defaults.frontend.start",
          "defaults.frontend.stop",
          "defaults.frontend.emit"
        ]
      }
    },
    "dev": {
      "type": "dev",
      "id": "dev",
      "path": "blocks/dev",
      "connectivity": {
        "provides": [
          "defaults.dev.inspect",
          "defaults.dev.prompt_history",
          "defaults.dev.edit_prompt_live",
          "defaults.dev.replay"
        ]
      }
    }
  },
  "load_order": [
    "memory:memory",
    "knowledge:knowledge",
    "prompt:prompt",
    "media:media",
    "ai_client:ai_client",
    "tool:tool",
    "coding:coding",
    "chat:chat",
    "agent:agent",
    "dev:dev",
    "frontend:frontend"
  ],
  "metadata": {
    "name": "Rumi Defaultspack v2",
    "description": "Primary v2 pack cloned from defaults and extended with canonical defaultspack management APIs.",
    "author": "Rumi AI Team",
    "license": "MIT"
  },
  "api_routes": [
    {
      "method": "GET",
      "path": "/api/defaultspack/modules",
      "function_id": "list_modules"
    },
    {
      "method": "GET",
      "path_pattern": "/api/defaultspack/modules/{id}",
      "function_id": "get_module",
      "path_param_map": {"module_id": "id"}
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/enable",
      "function_id": "set_module_state",
      "args": {"state": "enabled"},
      "path_param_map": {"module_id": "id"}
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/disable",
      "function_id": "set_module_state",
      "args": {"state": "disabled"},
      "path_param_map": {"module_id": "id"}
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/reload",
      "function_id": "set_module_state",
      "args": {"state": "enabled", "reason": "manual_reload"},
      "path_param_map": {"module_id": "id"}
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/rollback",
      "function_id": "set_module_state",
      "args": {"state": "disabled", "reason": "manual_rollback"},
      "path_param_map": {"module_id": "id"}
    },
    {
      "method": "GET",
      "path": "/api/defaultspack/migration/status",
      "function_id": "get_migration_status"
    },
    {
      "method": "GET",
      "path": "/api/defaultspack/pack-requests",
      "function_id": "list_pack_requests"
    },
    {
      "method": "GET",
      "path_pattern": "/api/defaultspack/pack-requests/{id}",
      "function_id": "get_pack_request",
      "path_param_map": {"request_id": "id"}
    },
    {
      "method": "POST",
      "path": "/api/defaultspack/pack-requests/request-extension",
      "function_id": "request_extension",
      "pass_body": true
    },
    {
      "method": "POST",
      "path": "/api/defaultspack/pack-requests/forced-patch",
      "function_id": "forced_patch",
      "pass_body": true
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/pack-requests/{id}/approve",
      "function_id": "review_pack_request",
      "pass_body": true,
      "args": {"decision": "approve"},
      "path_param_map": {"request_id": "id"}
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/pack-requests/{id}/reject",
      "function_id": "review_pack_request",
      "pass_body": true,
      "args": {"decision": "reject"},
      "path_param_map": {"request_id": "id"}
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/pack-requests/{id}/rollback",
      "function_id": "rollback_pack_request",
      "path_param_map": {"request_id": "id"}
    }
  ]
}
