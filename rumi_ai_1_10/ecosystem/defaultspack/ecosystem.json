  "metadata": {
    "name": "Rumi Defaultspack v2",
    "description": "Primary v2 pack cloned from defaults and extended with canonical defaultspack management APIs.",
    "author": "Rumi AI Team",
    "license": "MIT"
  },
  "capability_bindings": {
    "register": "ecosystem.defaultspack.capability_bindings.register_defaultspack_binding_handlers"
  },
  "capabilities": [
    "desktop_app.execute"
  ],
  "desktop_app": {
    "command": "python defaultspack/desktop_app.py",
    "working_dir": "",
    "env": {
      "DEFAULTS_HTTP_PORT": "8766",
      "RUMI_DEFAULTSPACK_PORT": "8766",
      "RUMI_DEFAULTSPACK_SURFACE": "webview"
    },
    "capabilities": [
      "desktop_app.execute"
    ],
    "window": {
      "title": "Rumi Defaultspack",
      "width": 1280,
      "height": 800,
      "icon": "assets/icons/defaultspack-icon.png"
    },
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "pre_auth_routes": [
    {
      "method": "POST",
      "path": "/api/integrations/line/webhook"
    },
    {
      "method": "POST",
      "path": "/api/integrations/slack/events"
    },
    {
      "method": "POST",
      "path": "/api/integrations/discord/interactions"
    },
    {
      "method": "POST",
      "path": "/api/integrations/discord/events"
    },
    {
      "method": "POST",
      "path": "/api/integrations/p2p/events"
    },
    {
      "method": "POST",
      "path_prefix": "/api/webhooks/inbound"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/api/defaultspack/modules",
      "function_id": "list_modules"
    },
    {
      "method": "GET",
      "path_pattern": "/api/defaultspack/modules/{id}",
      "function_id": "get_module",
      "path_param_map": {
        "module_id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/enable",
      "function_id": "set_module_state",
      "args": {
        "state": "enabled"
      },
      "path_param_map": {
        "module_id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/disable",
      "function_id": "set_module_state",
      "args": {
        "state": "disabled"
      },
      "path_param_map": {
        "module_id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/reload",
      "function_id": "set_module_state",
      "args": {
        "state": "enabled",
        "reason": "manual_reload"
      },
      "path_param_map": {
        "module_id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/modules/{id}/rollback",
      "function_id": "set_module_state",
      "args": {
        "state": "disabled",
        "reason": "manual_rollback"
      },
      "path_param_map": {
        "module_id": "id"
      }
    },
    {
      "method": "GET",
      "path": "/api/defaultspack/migration/status",
      "function_id": "get_migration_status"
    },
    {
      "method": "GET",
      "path": "/api/defaultspack/pack-requests",
      "function_id": "list_pack_requests"
    },
    {
      "method": "GET",
      "path_pattern": "/api/defaultspack/pack-requests/{id}",
      "function_id": "get_pack_request",
      "path_param_map": {
        "request_id": "id"
      }
    },
    {
      "method": "POST",
      "path": "/api/defaultspack/pack-requests/request-extension",
      "function_id": "request_extension",
      "pass_body": true
    },
    {
      "method": "POST",
      "path": "/api/defaultspack/pack-requests/forced-patch",
      "function_id": "forced_patch",
      "pass_body": true
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/pack-requests/{id}/approve",
      "function_id": "review_pack_request",
      "pass_body": true,
      "args": {
        "decision": "approve"
      },
      "path_param_map": {
        "request_id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/pack-requests/{id}/reject",
      "function_id": "review_pack_request",
      "pass_body": true,
      "args": {
        "decision": "reject"
      },
      "path_param_map": {
        "request_id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/defaultspack/pack-requests/{id}/rollback",
      "function_id": "rollback_pack_request",
      "path_param_map": {
        "request_id": "id"
      }
    },
    {
      "method": "GET",
      "path": "/api/tools/mcp",
      "function_id": "tool_mcp_list"
    },
    {
      "method": "POST",
      "path": "/api/tools/mcp/connect",
      "function_id": "tool_mcp_connect",
      "pass_body": true
    }
  ]
}
