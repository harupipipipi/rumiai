{
  "id": "sandbox_exec",
  "description": "Request approved command execution in the managed sandbox runtime; fail closed when no provider is ready.",
  "config": {
    "tool_id": "sandbox_exec",
    "name": "Sandbox Exec",
    "summary": "Request approved command execution in the managed sandbox runtime; fail closed when no provider is ready.",
    "tool_category": "sandbox",
    "action_type": "execute",
    "write_action": true,
    "requires_approval": true,
    "risk": "high",
    "tags": [
      "sandbox",
      "agent_os",
      "artifact_workspace"
    ],
    "ui": {
      "group_id": "sandbox",
      "group_label": "Sandbox",
      "group_icon": "terminal",
      "item_icon": "terminal",
      "widget_kind": "tool_toggle",
      "composer_label": "Sandbox Exec",
      "composer_description": "Request approved command execution in the managed sandbox runtime; fail closed when no provider is ready.",
      "composer_icon": "terminal"
    },
    "schema": {
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "argv"
            ]
          },
          {
            "required": [
              "command"
            ]
          }
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Preferred command argument vector. Public callers must use argv arrays, not shell strings."
          },
          "command": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ],
            "description": "Legacy compatibility input. Strings are parsed without shell syntax; arrays are treated as argv."
          },
          "sandbox_id": {
            "type": "string"
          },
          "template_id": {
            "type": "string"
          },
          "provider_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "stdin": {
            "type": "string"
          },
          "timeout": {
            "type": "integer"
          },
          "timeout_ms": {
            "type": "integer"
          },
          "client_request_id": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "local",
      "handler": "domain.tool.sandbox_tools:sandbox_exec"
    }
  }
}
