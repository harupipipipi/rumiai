{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rumi-cloudflare-pc-tool-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RUMI_PC_ORIGIN": "https://rumi-pc.example.com"
  },
  "observability": {
    "enabled": true
  }
}
