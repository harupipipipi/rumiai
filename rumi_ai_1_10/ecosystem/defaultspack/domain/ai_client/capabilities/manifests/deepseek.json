{
  "provider_id": "deepseek",
  "api_surface": {
    "api_family": "openai_compatible",
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "tool_call",
      "tool_result",
      "reasoning"
    ],
    "supports_tool_call_shape": true,
    "supports_parallel_tool_call_shape": false,
    "tool_choice_modes": [
      "auto",
      "none"
    ],
    "schema_support": {
      "json_schema": true
    },
    "params": {
      "temperature": true,
      "max_tokens": true,
      "top_p": true
    }
  },
  "supported_roles": [
    "system",
    "user",
    "assistant",
    "tool"
  ],
  "quirks": {
    "drop_reasoning_when_none": true,
    "supports_stream_usage": false
  }
}
