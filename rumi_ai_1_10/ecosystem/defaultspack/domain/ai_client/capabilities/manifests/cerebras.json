{
  "provider_id": "cerebras",
  "api_surface": {
    "api_family": "openai_compatible",
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "tool_call",
      "tool_result"
    ],
    "supports_tool_call_shape": true,
    "supports_parallel_tool_call_shape": true,
    "tool_choice_modes": [
      "auto",
      "none"
    ],
    "schema_support": {
      "json_schema": true,
      "strict_json_schema": false
    },
    "params": {
      "temperature": true,
      "max_completion_tokens": true,
      "top_p": true,
      "reasoning_effort": true
    }
  },
  "supported_roles": [
    "system",
    "user",
    "assistant",
    "tool"
  ],
  "quirks": {
    "max_tokens_name": "max_completion_tokens",
    "max_completion_tokens_name": "max_completion_tokens",
    "drop_reasoning_when_none": true,
    "reasoning_effort_values": [
      "low",
      "medium",
      "high"
    ],
    "supports_stream_usage": false
  }
}
