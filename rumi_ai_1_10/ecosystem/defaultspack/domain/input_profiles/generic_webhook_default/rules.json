{
  "profile": {
    "id": "generic.webhook.default",
    "provider": "generic",
    "version": 1,
    "display_name": "Generic Webhook Default",
    "match": {
      "event_type": "message"
    },
    "input": {
      "role": "user",
      "content": "coalesce($.text, $.message, $.content, 'Webhook event received')"
    },
    "metadata": {
      "source": {
        "kind": "webhook",
        "provider": "generic"
      },
      "webhook": {
        "payload": "$"
      }
    },
    "params": {
      "external_input": {
        "default_response": {
          "mode": "same_response",
          "include_source_context": true,
          "source_context_format": "${provider}\u304b\u3089\u6765\u305f\u5165\u529b\u3067\u3059\u3002"
        }
      }
    },
    "response_prompt": {
      "enabled": false
    }
  }
}
