{
  "id": "gitlawb-opengateway",
  "provider_id": "gitlawb-opengateway",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "Gitlawb OpenGateway",
  "entrypoints": {
    "adapter": "../ai_client/providers/gitlawb_opengateway_provider.py",
    "models": "models.json"
  },
  "security": {
    "credential_required": false,
    "privacy": "external_no_key_gateway",
    "browser_user_agent": true,
    "fixed_model_allowlist": true
  },
  "capabilities": {
    "chat": true,
    "streaming": true,
    "reasoning": true,
    "vision": true,
    "openai_compatible": true
  },
  "provider_metadata": {
