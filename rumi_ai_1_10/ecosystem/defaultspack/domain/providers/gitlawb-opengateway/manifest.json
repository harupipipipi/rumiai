    "config": {
      "model_sync": "fixed_allowlist",
      "privacy": "external_no_key_gateway"
    }
  },
  "aliases": {
    "provider_ids": ["gitlawb-opengateway"]
  },
  "compatibility": {
    "legacy_ids": [
      "gitlawb-opengateway",
      "gitlawb-opengateway/mimo-v2.5-pro",
      "gitlawb-opengateway/mimo-v2-flash",
      "gitlawb-opengateway/google/gemini-3.1-flash-lite-preview"
    ]
  },
  "source_pack_id": "defaultspack"
