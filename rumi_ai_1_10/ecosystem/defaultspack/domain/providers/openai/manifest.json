{
  "id": "openai",
  "provider_id": "openai",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "OpenAI",
  "entrypoints": {
    "adapter": "../ai_client/providers/openai_provider.py"
  },
  "security": {
    "credential_required": true
  },
  "capabilities": {
    "chat": true,
    "tool_calls": true,
    "vision": true,
    "embedding": true,
    "image": true
  },
  "provider_metadata": {
    "display_name": "OpenAI",
    "kind": "cloud",
    "env_vars": ["OPENAI_API_KEY"],
    "base_url_envs": ["OPENAI_BASE_URL"],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "gpt-5.4",
    "capabilities": ["chat", "tool_calls", "vision", "embedding", "image", "transcription", "tts"]
  },
  "aliases": {
    "provider_ids": ["openai"]
  },
  "compatibility": {
    "legacy_ids": ["openai"]
  },
  "source_pack_id": "defaultspack"
}
