{
  "id": "coding_terminal_exec",
  "category": "tool",
  "version": "1",
  "display_name": "Run Command",
  "description": "Run a local workspace command with approval policy.",
  "enabled": true,
  "config": {
    "name": "coding_terminal_exec",
    "summary": "Run a workspace command",
    "tags": ["coding", "terminal", "command"],
    "ui": {
      "group_id": "workspace_terminal",
      "group_label": "Terminal",
      "group_icon": "terminal",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle"
    },
    "tool_category": "shell",
    "action_type": "shell",
    "requires_approval": true,
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "command": {"type": "string"},
          "cwd": {"type": "string"},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 120}
        },
        "required": ["command"]
      }
    },
    "execution": {"type": "local"},
    "handler": "blocks.coding.terminal_exec:run"
  }
}
