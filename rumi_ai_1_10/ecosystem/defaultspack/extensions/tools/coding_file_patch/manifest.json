{
  "id": "coding_file_patch",
  "category": "tool",
  "version": "1",
  "display_name": "Patch File",
  "description": "Apply an old/new replacement patch after approval.",
  "enabled": true,
  "config": {
    "name": "coding_file_patch",
    "summary": "Patch a workspace file",
    "tags": ["coding", "file", "patch"],
    "ui": {
      "group_id": "coding/files/write",
      "group_label": "Write",
      "group_icon": "file",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {"id": "approval_policy", "label": "Approval Policy", "type": "select", "default": "prompt", "options": [{"value": "prompt", "label": "Prompt"}, {"value": "always_require", "label": "Always Require"}]},
        {"id": "default_workspace_root", "label": "Default Workspace Root", "type": "text", "default": "", "help": "Durable root used when a workspace root is not provided by the runtime."},
        {"id": "preflight_by_default", "label": "Preflight By Default", "type": "toggle", "default": true},
        {"id": "diff_context_lines", "label": "Diff Context Lines", "type": "number", "default": 3, "min": 0, "max": 20}
      ]
    },
    "tool_category": "filesystem_write",
    "action_type": "update",
    "write_action": true,
    "requires_approval": true,
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "old": {"type": "string"},
          "new": {"type": "string"}
        },
        "required": ["path", "old", "new"]
      }
    },
    "execution": {"type": "local"},
    "handler": "blocks.coding.file_patch:run"
  }
}
