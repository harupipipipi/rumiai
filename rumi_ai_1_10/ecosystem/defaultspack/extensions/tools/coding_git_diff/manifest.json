{
  "id": "coding_git_diff",
  "category": "tool",
  "version": "1",
  "display_name": "Git Diff",
  "description": "Read git diff for the workspace.",
  "enabled": true,
  "config": {
    "name": "coding_git_diff",
    "summary": "Read git diff",
    "tags": ["coding", "git", "read"],
    "ui": {
      "group_id": "coding/github/status",
      "group_label": "Status",
      "group_icon": "git",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {"id": "default_workspace_root", "label": "Default Workspace Root", "type": "text", "default": "", "help": "Durable root used when a workspace root is not provided by the runtime."},
        {"id": "diff_context_lines", "label": "Diff Context Lines", "type": "number", "default": 3, "min": 0, "max": 20},
        {"id": "max_output_chars", "label": "Max Output Chars", "type": "number", "default": 20000, "min": 1000, "max": 200000}
      ]
    },
    "tool_category": "git",
    "action_type": "read",
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "ref": {"type": "string"},
          "workspace_root": {"type": "string"}
        },
        "required": []
      }
    },
    "execution": {"type": "local"},
    "handler": "blocks.coding.git_diff:run"
  }
}
