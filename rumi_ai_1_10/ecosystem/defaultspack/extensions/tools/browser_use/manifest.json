{
  "id": "browser_use",
  "category": "tool",
  "version": "1",
  "display_name": "Browser Use",
  "description": "Open URLs, inspect browser state, capture screenshots for vision-capable models, and move the cursor from screenshot coordinates.",
  "enabled": true,
  "config": {
    "name": "browser_use",
    "summary": "ブラウザ操作",
    "tags": ["browser", "vision", "screenshot", "cursor"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["session", "open_url", "screenshot", "move", "click", "type", "key", "scroll"],
            "default": "session"
          },
          "url": {"type": "string"},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "text": {"type": "string"},
          "key": {"type": "string"},
          "amount": {"type": "integer"},
          "dry_run": {"type": "boolean"},
          "approval_token": {"type": "string"},
          "payload": {"type": "object"}
        }
      }
    },
    "execution": {"type": "local"},
    "requires_approval": true,
    "ui": {
      "group_id": "browser",
      "group_label": "Browser",
      "composer_label": "Browser Use",
      "composer_icon": "globe",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle"
    }
  }
}
