{
  "id": "browser_use",
  "category": "tool",
  "version": "1",
  "display_name": "Browser Use",
  "description": "Open URLs, manage browser sessions, inspect tabs, capture browser snapshots/screenshots, and fall back to computer_use when direct browser refs cannot be executed.",
  "enabled": true,
  "config": {
    "name": "browser_use",
    "summary": "ブラウザ操作",
    "tags": ["browser", "vision", "screenshot", "cursor", "cdp"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "session",
              "open_url",
              "screenshot",
              "move",
              "click",
              "input",
              "type",
              "key",
              "scroll",
              "wait",
              "zoom",
              "new_tab",
              "close_tab",
              "refresh",
              "reload",
              "select_all",
              "copy",
              "paste",
              "profile_list",
              "profile_get",
              "profile_create",
              "profile_update",
              "profile_delete",
              "profile_set_active",
              "start",
              "stop",
              "restart",
              "health",
              "sessions",
              "tabs",
              "open_tab",
              "focus_tab",
              "close_tab",
              "navigate",
              "snapshot",
              "click_ref",
              "type_ref",
              "key_ref",
              "scroll_ref"
            ],
            "default": "session"
          },
          "url": {"type": "string"},
          "profile_id": {"type": "string"},
          "session_id": {"type": "string"},
          "tab_id": {"type": "string"},
          "ref": {"type": "string"},
          "ref_id": {"type": "string"},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "point": {
            "description": "Gemini/browser operator point in [y, x] order, normalized from 0 to 1000.",
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          },
          "points": {
            "description": "List of operator points such as [{\"point\":[y,x]}]. The first point is used for click/move.",
            "type": "array"
          },
          "normalized_point": {
            "description": "Normalized 0..1000 point object or [y,x] array.",
            "type": ["object", "array"]
          },
          "point_order": {
            "type": "string",
            "enum": ["yx", "xy"],
            "default": "yx"
          },
          "text": {"type": "string"},
          "input_text": {"type": "string"},
          "key": {"type": "string"},
          "amount": {"type": "integer"},
          "direction": {"type": "string", "enum": ["up", "down", "left", "right"]},
          "seconds": {"type": "number"},
          "coordinate_space": {
            "type": "string",
            "enum": ["model_image", "source_image", "target_window", "screenshot_image", "normalized_1000", "desktop", "action", "screen"]
          },
          "quality": {
            "type": "string",
            "enum": ["compact", "standard", "high_detail"]
          },
          "name": {"type": "string"},
          "schema": {"type": "string", "enum": ["managed_chromium"], "default": "managed_chromium"},
          "browser": {"type": "string"},
          "settings": {"type": "object"},
          "metadata": {"type": "object"},
          "launch": {"type": "boolean"},
          "current_snapshot": {"type": "object"},
          "dry_run": {"type": "boolean"},
          "approval_token": {"type": "string"},
          "payload": {"type": "object"}
        }
      }
    },
    "execution": {"type": "local"},
    "requires_approval": true,
    "ui": {
      "group_id": "browser",
      "group_label": "Browser",
      "composer_label": "Browser Use",
      "composer_icon": "globe",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "target",
          "label": "Default Target",
          "type": "select",
          "default": "active_session",
          "options": [
            {"value": "active_session", "label": "Active Session"},
            {"value": "new_tab", "label": "New Tab"},
            {"value": "isolated_session", "label": "Isolated Session"}
          ],
          "help": "Default browser context for new tasks; request-specific details are supplied at call time."
        },
        {
          "id": "mode",
          "label": "Default Mode",
          "type": "select",
          "default": "inspect_first",
          "options": [
            {"value": "inspect_first", "label": "Inspect First"},
            {"value": "direct", "label": "Direct Action"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Preferred operating mode before issuing browser actions."
        },
        {
          "id": "safety",
          "label": "Safety Default",
          "type": "select",
          "default": "approval_required",
          "options": [
            {"value": "approval_required", "label": "Require Approval"},
            {"value": "dry_run_first", "label": "Dry Run First"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Durable safety preference for browser operations."
        },
        {
          "id": "quality",
          "label": "Screenshot Quality",
          "type": "select",
          "default": "standard",
          "options": [
            {"value": "compact", "label": "Compact"},
            {"value": "standard", "label": "Standard"},
            {"value": "high_detail", "label": "High Detail"}
          ],
          "help": "Default screenshot/detail preference for visual inspection."
        }
      ]
    }
  }
}
