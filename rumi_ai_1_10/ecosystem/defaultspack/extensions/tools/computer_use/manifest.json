{
  "id": "computer_use",
  "category": "tool",
  "version": "2",
  "display_name": "Computer Use",
  "description": "Inspect the desktop and run approved Computer Use v2 actions on macOS or Windows.",
  "enabled": true,
  "config": {
    "name": "computer_use",
    "summary": "コンピューター操作",
    "tags": ["computer", "desktop", "screenshot", "approval"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "screenshot",
              "move",
              "click",
              "type",
              "key",
              "scroll",
              "computer.health",
              "computer.permissions",
              "computer.displays.list",
              "computer.active_window",
              "computer.windows.list",
              "computer.window.focus",
              "computer.window.bounds",
              "computer.screenshot",
              "computer.move",
              "computer.click",
              "computer.type",
              "computer.key",
              "computer.hotkey",
              "computer.scroll",
              "computer.clipboard.read",
              "computer.clipboard.write",
              "computer.app.open",
              "computer.app.focus"
            ],
            "default": "screenshot"
          },
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "width": {"type": "integer"},
          "height": {"type": "integer"},
          "window_id": {"type": "string"},
          "window_index": {"type": "integer"},
          "combo": {"type": "string"},
          "keys": {"type": "array", "items": {"type": "string"}},
          "app": {"type": "string"},
          "name": {"type": "string"},
          "path": {"type": "string"},
          "bundle_id": {"type": "string"},
          "text": {"type": "string"},
          "content": {"type": "string"},
          "key": {"type": "string"},
          "amount": {"type": "integer"},
          "limit": {"type": "integer"},
          "dry_run": {"type": "boolean"},
          "approval_id": {"type": "string"},
          "approval_token": {"type": "string"},
          "approval_session_id": {"type": "string"},
          "payload": {"type": "object"}
        }
      }
    },
    "execution": {"type": "local"},
    "requires_approval": true,
    "action_type": "desktop",
    "ui": {
      "group_id": "computer",
      "group_label": "Computer",
      "composer_label": "Computer Use",
      "composer_icon": "monitor",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "target",
          "label": "Default Target",
          "type": "select",
          "default": "primary_display",
          "options": [
            {"value": "primary_display", "label": "Primary Display"},
            {"value": "active_window", "label": "Active Window"},
            {"value": "all_displays", "label": "All Displays"}
          ],
          "help": "Default desktop target for new tasks; request-specific details are supplied at call time."
        },
        {
          "id": "mode",
          "label": "Default Mode",
          "type": "select",
          "default": "inspect_first",
          "options": [
            {"value": "inspect_first", "label": "Inspect First"},
            {"value": "direct", "label": "Direct Action"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Preferred operating mode before issuing desktop actions."
        },
        {
          "id": "safety",
          "label": "Safety Default",
          "type": "select",
          "default": "approval_required",
          "options": [
            {"value": "approval_required", "label": "Require Approval"},
            {"value": "dry_run_first", "label": "Dry Run First"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Durable safety preference for desktop operations."
        },
        {
          "id": "quality",
          "label": "Screenshot Quality",
          "type": "select",
          "default": "standard",
          "options": [
            {"value": "compact", "label": "Compact"},
            {"value": "standard", "label": "Standard"},
            {"value": "high_detail", "label": "High Detail"}
          ],
          "help": "Default screenshot/detail preference for visual inspection."
        }
      ]
    }
  }
}
