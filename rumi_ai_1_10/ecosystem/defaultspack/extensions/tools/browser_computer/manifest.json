{
  "id": "browser_computer",
  "category": "tool",
  "version": "2",
  "display_name": "Browser / Computer",
  "description": "Open browser URLs, inspect sessions, and run approved Computer Use v2 desktop actions.",
  "enabled": true,
  "config": {
    "name": "browser_computer",
    "summary": "Approved browser and computer actions",
    "tags": ["browser", "computer", "approval"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "browser.open_url",
              "browser.session",
              "browser.profiles.list",
              "browser.profile.create",
              "browser.profile.set_active",
              "browser.profile.delete",
              "browser.profile.clear_cache",
              "browser.profile.clear_cookies",
              "browser.cookies.list",
              "browser.cookies.import",
              "browser.cookies.delete",
              "computer.health",
              "computer.permissions",
              "computer.displays.list",
              "computer.active_window",
              "computer.windows.list",
              "computer.window.focus",
              "computer.window.bounds",
              "computer.screenshot",
              "computer.move",
              "computer.click",
              "computer.type",
              "computer.key",
              "computer.hotkey",
              "computer.scroll",
              "computer.clipboard.read",
              "computer.clipboard.write",
              "computer.app.open",
              "computer.app.focus"
            ]
          },
          "payload": {"type": "object"}
        },
        "required": ["action"]
      }
    },
    "execution": {"type": "local"},
    "handler": "domain.tool.executor:ToolExecutor.execute",
    "requires_approval": true,
    "ui": {
      "group_id": "browser_computer",
      "group_label": "Browser / Computer",
      "composer_label": "Browser / Computer",
      "composer_icon": "mouse-pointer-click",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "target",
          "label": "Default Target",
          "type": "select",
          "default": "focused_app_window",
          "options": [
            {"value": "focused_app_window", "label": "Focused App Window"},
            {"value": "app", "label": "App"},
            {"value": "window", "label": "Window"},
            {"value": "active_window", "label": "Active Window"},
            {"value": "browser_first", "label": "Browser First"},
            {"value": "desktop_first", "label": "Desktop First"},
            {"value": "full_desktop", "label": "Full Desktop"}
          ],
          "help": "Prefer focused app/window operation for desktop tools; full desktop remains available for whole-screen tasks."
        },
        {
          "id": "mode",
          "label": "Default Mode",
          "type": "select",
          "default": "inspect_first",
          "options": [
            {"value": "inspect_first", "label": "Inspect First"},
            {"value": "direct", "label": "Direct Action"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Preferred operating mode before issuing cross-surface actions."
        },
        {
          "id": "safety",
          "label": "Safety Default",
          "type": "select",
          "default": "approval_required",
          "options": [
            {"value": "approval_required", "label": "Require Approval"},
            {"value": "dry_run_first", "label": "Dry Run First"},
            {"value": "read_only", "label": "Read Only"}
          ],
          "help": "Durable safety preference for cross-surface operations."
        },
        {
          "id": "quality",
          "label": "Screenshot Quality",
          "type": "select",
          "default": "standard",
          "options": [
            {"value": "compact", "label": "Compact"},
            {"value": "standard", "label": "Standard"},
            {"value": "high_detail", "label": "High Detail"}
          ],
          "help": "Default visual detail preference for browser and desktop inspection."
        }
      ]
    }
  }
}
