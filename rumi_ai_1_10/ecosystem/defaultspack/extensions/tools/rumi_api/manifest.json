{
  "id": "rumi_api",
  "category": "tool",
  "version": "1",
  "display_name": "Rumi API",
  "description": "Inspect and call the local defaultspack API from agents.",
  "enabled": true,
  "config": {
    "name": "rumi_api",
    "summary": "Rumi API",
    "tags": ["api", "rumi", "agent", "operations"],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list_routes", "request"],
            "default": "list_routes"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE"],
            "default": "GET"
          },
          "path": {"type": "string"},
          "body": {"type": "object"},
          "allow_mutation": {"type": "boolean", "default": false}
        }
      }
    },
    "execution": {
      "type": "handler",
      "handler": "domain.tool.rumi_api:run"
    },
    "requires_approval": false,
    "ui": {
      "group_id": "agent",
      "group_label": "Agent",
      "composer_label": "Rumi API",
      "composer_icon": "plug",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle"
    }
  }
}
