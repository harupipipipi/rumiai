{
  "id": "coding_file_search",
  "category": "tool",
  "version": "1",
  "display_name": "Search Files",
  "description": "Search workspace files with a glob pattern.",
  "enabled": true,
  "config": {
    "name": "coding_file_search",
    "summary": "Search workspace files",
    "tags": ["coding", "file", "search"],
    "ui": {
      "group_id": "coding/files/read",
      "group_label": "Read",
      "group_icon": "file",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle"
    },
    "tool_category": "filesystem",
    "action_type": "read",
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {"type": "string"},
          "directory": {"type": "string"}
        },
        "required": ["pattern"]
      }
    },
    "execution": {"type": "local"},
    "handler": "blocks.coding.file_search:run"
  }
}
