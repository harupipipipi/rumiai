{
  "pack_id": "rumi_sandbox_runtime_pack",
  "pack_identity": "rumi:ecosystem/rumi_sandbox_runtime_pack",
  "display_name": "Rumi Sandbox Runtime Pack",
  "version": "0.1.0",
  "description": "Declarative sandbox/runtime pack for safe code execution boundaries, secret-mount review, runtime receipts, and reproducibility checklists.",
  "vocabulary": {
    "types": [
      "catalog",
      "policy",
      "profile",
      "prompt",
      "preset",
      "template",
      "example",
      "spec",
      "checklist",
      "evidence"
    ]
  },
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "components": {},
  "load_order": [],
  "required_secrets": [],
  "required_network": [],
  "host_execution": false,
  "metadata": {
    "required_secrets": [],
    "network_policy": "none_by_default",
    "executable_code": false,
    "registers_tools": false,
    "optional_integrations": [
      {
        "pack_id": "rumi_code_ide_pack",
        "reason": "Consumes sandbox boundary and receipt evidence for coding workflows; owns IDE workflow orchestration."
      },
      {
        "pack_id": "rumi_computer_control_pack",
        "reason": "Owns desktop control and host interaction; this pack only classifies runtime boundaries."
      },
      {
        "pack_id": "rumi_security_review_pack",
        "reason": "Owns secret, permission, and high-risk command review."
      },
      {
        "pack_id": "rumi_devops_release_pack",
        "reason": "Owns release/deploy execution; this pack only records sandbox job receipts."
      }
    ],
    "owner_surfaces": [
      "sandbox_contracts",
      "runtime_isolation_matrix",
      "execution_evidence",
      "artifact_job_boundaries",
      "secret_mount_review",
      "runtime_receipts",
      "reproducibility_checklists"
    ],
    "asset_index": {
      "readme": ["README.md"],
      "docs": [
        "docs/README.md",
        "docs/architecture.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ],
      "catalogs": ["catalog/runtime_matrix.yaml"],
      "policies": [
        "policies/sandbox_execution.policy.yaml",
        "policies/secret_mount.policy.yaml"
      ],
      "profiles": ["profiles/sandbox_runtime_reviewer.profile.yaml"],
      "prompts": ["prompts/sandbox_runtime_reviewer.system.md"],
      "presets": [
        "presets/safe_default.preset.yaml",
        "presets/handoff_review.preset.yaml",
        "presets/quality_gate.preset.yaml"
      ],
      "examples": [
        "examples/container_test_run.example.yaml",
        "examples/host_command_review.example.yaml",
        "examples/remote_runtime_scope.example.yaml"
      ],
      "specs": [
        "specs/execution_boundary_matrix.yaml",
        "specs/runtime_receipt.schema.yaml"
      ],
      "templates": [
        "templates/coding.node/template.json",
        "templates/coding.python/template.json",
        "templates/coding.rust/template.json",
        "templates/desktop.browser/template.json",
        "templates/desktop.ubuntu/template.json",
        "templates/pack.networked/template.json",
        "templates/pack.safe/template.json",
        "templates/tool.ephemeral/template.json"
      ],
      "checklists": ["checklists/reproducibility_checklist.yaml"],
      "evidence": ["evidence/runtime_receipt_ledger.template.yaml"]
    }
  }
}
