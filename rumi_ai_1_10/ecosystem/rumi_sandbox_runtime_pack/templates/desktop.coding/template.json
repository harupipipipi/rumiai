{
  "schema_version": 1,
  "kind": "rumi.sandbox.template",
  "id": "desktop.coding",
  "version": "1.0.0",
  "display_name": "Coding Desktop",
  "summary": "Ubuntu desktop seat prepared for browser-based coding, terminal workflows, and approved MCP/tool installation.",
  "source_pack_id": "rumi_sandbox_runtime_pack",
  "extends": "desktop.browser",
  "runtime": {
    "os": "ubuntu",
    "provider": "auto",
    "provider_requirements": [
      "sandbox.desktop",
      "sandbox.desktop_input",
      "sandbox.snapshot",
      "sandbox.network_policy"
    ],
    "capabilities": [
      "sandbox.desktop",
      "sandbox.desktop_input",
      "sandbox.snapshot",
      "sandbox.network.allowlist"
    ],
    "packages": [
      {
        "manager": "guest",
        "name": "google-chrome-stable",
        "version": "managed"
      },
      {
        "manager": "guest",
        "name": "xterm",
        "version": "managed"
      },
      {
        "manager": "guest",
        "name": "python",
        "version": "3.11+"
      },
      {
        "manager": "guest",
        "name": "node",
        "version": "20+"
      }
    ]
  },
  "provisioning": {
    "default": true,
    "apps": [
      "google-chrome-stable",
      "xterm",
      "code-editor"
    ],
    "mcp_servers": [
      "playwright"
    ]
  },
  "policy": {
    "filesystem": {
      "mode": "writable_overlay",
      "workspace": {
        "access": "overlay",
        "requires_user_selection": true,
        "writeback_requires_approval": true
      },
      "host_mounts": [],
      "arbitrary_host_mounts": false
    },
    "network": {
      "mode": "project_policy_or_first_use_approval",
      "allowlist": [],
      "requires_approval": true
    },
    "secrets": {
      "mode": "explicit_read_only",
      "ambient": false,
      "mounts": [],
      "requires_approval": true
    },
    "desktop": {
      "enabled": true,
      "display_backend": "xvfb_openbox",
      "visible_host_window": false,
      "width": 1440,
      "height": 900,
      "starter": "browser",
      "profile": "ephemeral",
      "browser": {
        "engine": "chrome",
        "profile": "ephemeral",
        "persistence_requires_approval": true,
        "allowed_url_schemes": [
          "http",
          "https"
        ]
      }
    },
    "resources": {
      "cpu": 2,
      "memory_mb": 4096,
      "timeout_seconds": 14400,
      "max_output_bytes": 8388608
    },
    "lifecycle": {
      "ttl_seconds": 14400,
      "persistence": "branch_session",
      "destroy_on_idle": false
    },
    "approvals": {
      "network_broaden": "required",
      "package_install": "required",
      "secret_mount": "required",
      "host_writeback": "required",
      "persistence": "project_policy",
      "mcp_install": "required"
    }
  },
  "allowed_operations": [
    "desktop.observe",
    "desktop.input.with_lease",
    "desktop.snapshot",
    "desktop.tool.install.request",
    "desktop.mcp.install.request"
  ],
  "user_overrides": {
    "narrow_only": true,
    "allowed_fields": [
      "name",
      "resolution",
      "browser.url",
      "workspace.binding",
      "network.allowlist",
      "agent_assignment",
      "provisioning.apps",
      "provisioning.mcp_servers"
    ]
  },
  "contract": {
    "no_backend_entrypoint": true,
    "no_provider_command": true,
    "no_arbitrary_host_mounts": true,
    "no_privileged_mode": true,
    "no_ambient_host_environment": true,
    "public_exec_requires_argv": true,
    "human_control_requires_lease": true,
    "provisioning_requires_provider_receipts": true
  }
}
