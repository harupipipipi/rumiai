{
  "schema_version": 1,
  "kind": "rumi.sandbox.template",
  "id": "tool.ephemeral",
  "version": "1.0.0",
  "display_name": "Ephemeral Tool",
  "summary": "Short-lived no-network tool sandbox with strict resource and output limits.",
  "source_pack_id": "rumi_sandbox_runtime_pack",
  "runtime": {
    "os": "linux",
    "provider": "auto",
    "provider_requirements": [
      "sandbox.exec",
      "sandbox.files",
      "sandbox.resource_limits"
    ],
    "capabilities": [
      "sandbox.exec"
    ],
    "packages": []
  },
  "policy": {
    "filesystem": {
      "mode": "ephemeral_overlay",
      "workspace": {
        "access": "none_unless_explicit",
        "allowed_access": [
          "none",
          "read_only"
        ],
        "requires_user_selection": true
      },
      "host_mounts": [],
      "arbitrary_host_mounts": false
    },
    "network": {
      "mode": "off",
      "allowlist": [],
      "requires_approval": false
    },
    "secrets": {
      "mode": "deny",
      "ambient": false,
      "mounts": []
    },
    "desktop": {
      "enabled": false
    },
    "resources": {
      "cpu": 1,
      "memory_mb": 512,
      "timeout_seconds": 300,
      "max_output_bytes": 262144
    },
    "lifecycle": {
      "ttl_seconds": 300,
      "persistence": "ephemeral",
      "destroy_on_idle": true
    },
    "approvals": {
      "network_broaden": "deny",
      "secret_mount": "deny",
      "host_writeback": "deny",
      "persistence": "deny"
    }
  },
  "allowed_operations": [
    "sandbox.exec.argv"
  ],
  "user_overrides": {
    "narrow_only": true,
    "allowed_fields": [
      "name",
      "ttl_seconds",
      "workspace.read_only"
    ]
  },
  "contract": {
    "no_backend_entrypoint": true,
    "no_provider_command": true,
    "no_arbitrary_host_mounts": true,
    "no_privileged_mode": true,
    "no_ambient_host_environment": true,
    "public_exec_requires_argv": true
  }
}
