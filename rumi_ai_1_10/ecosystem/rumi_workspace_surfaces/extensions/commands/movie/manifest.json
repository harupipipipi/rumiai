  "ui": {
    "surface": { "kind": "movie", "layoutMode": "split", "chatPlacement": "left" },
    "operations": [
      "movie_import_media",
      "movie_edit_timeline",
      "movie_trim_clip",
      "movie_split_clip",
      "movie_update_captions",
