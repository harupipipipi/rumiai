  "load_order": [],
  "metadata": {
    "required_secrets": [],
    "network_policy": "none_by_default",
    "executable_code": false,
    "declarative_only": true,
    "optional_integrations": [
      {
        "pack_id": "rumi_agent_services_pack",
        "reason": "Agent execution and background coordination are owned by agent services; this pack only routes and records PR governance decisions."
      },
      {
        "pack_id": "rumi_code_ide_pack",
        "reason": "Code edits and conflict resolution are delegated to code/IDE owners; this pack preserves assignment and review evidence."
      },
      {
        "pack_id": "rumi_observability_pack",
        "reason": "Run metrics and durable telemetry are delegated to observability; this pack records the requested ledger shape."
      },
      {
        "pack_id": "rumi_pack_suite_pack",
        "reason": "Suite selection and release bundling are delegated to suite owners; this pack governs one-pack-one-PR readiness."
      }
    ],
    "owner_surfaces": [
