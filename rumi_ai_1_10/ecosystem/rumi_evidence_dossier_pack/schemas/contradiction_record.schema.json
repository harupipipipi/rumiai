{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/contradiction_record.schema.json",
  "title": "Contradiction Record",
  "description": "Contradiction review contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contradiction_id",
    "claim_ids",
    "evidence_ids",
    "severity",
    "resolution_state",
    "reviewer_notes"
  ],
  "properties": {
    "contradiction_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "resolution_state": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved",
        "accepted_limitation",
        "blocked"
      ]
    },
    "reviewer_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
