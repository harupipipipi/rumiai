{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/claim_record.schema.json",
  "title": "Claim Record",
  "description": "Claim node in evidence graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "claim_type",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "factual",
        "interpretive",
        "numeric",
        "decision",
        "quote"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "supported",
        "contradicted",
        "uncited",
        "blocked"
      ]
    }
  }
}
