{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/inbox_ui_view.schema.json",
  "title": "Inbox UI View",
  "description": "UI contract for omnichannel inbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "view_id",
    "lanes",
    "filters",
    "visible_actions",
    "approval_actions",
    "readonly",
    "forbidden_actions",
    "remote_input_can_authorize"
  ],
  "properties": {
    "view_id": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "title",
          "state_filter"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state_filter": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visible_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "approve_outbound",
          "deny_outbound",
          "route_thread",
          "block_channel"
        ]
      }
    },
    "readonly": {
      "type": "boolean"
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remote_input_can_authorize": {
      "type": "boolean",
      "const": false
    }
  }
}
