{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/identity_map.schema.json",
  "title": "Identity Map",
  "description": "Cross-channel identity mapping contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_id",
    "linked_sender_refs",
    "verification_state",
    "merge_evidence_ids",
    "risk_notes",
    "remote_input_can_merge",
    "conflict_resolution"
  ],
  "properties": {
    "identity_id": {
      "type": "string",
      "minLength": 1
    },
    "linked_sender_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "verified",
        "probable",
        "unverified",
        "conflict"
      ]
    },
    "merge_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remote_input_can_merge": {
      "type": "boolean",
      "const": false
    },
    "conflict_resolution": {
      "type": "string",
      "enum": [
        "verified_match",
        "manual_review",
        "blocked"
      ]
    }
  }
}
