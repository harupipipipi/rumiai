{
  "pack_id": "rumi_agent_workroom_pack",
  "pack_identity": "rumi:ecosystem/rumi_agent_workroom_pack",
  "display_name": "Rumi Agent Workroom Pack",
  "version": "0.1.0",
  "description": "Declarative async agent workroom contracts for run state, plans, progress events, checkpoint/resume, intervention, replay, and run-board review.",
  "vocabulary": {
    "types": [
      "catalog",
      "schema",
      "policy",
      "checklist",
      "ledger",
      "template",
      "fixture",
      "profile",
      "prompt",
      "preset",
      "example"
    ]
  },
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "components": {},
  "load_order": [],
  "required_secrets": [],
  "required_network": [],
  "host_execution": false,
  "metadata": {
    "runtime_type": "declarative_setup_pack",
    "required_secrets": [],
    "network_policy": "none_by_default",
    "executable_code": false,
    "declarative_only": true,
    "consumes_existing_sources_only": true,
    "output_effect": "draft_and_handoff_only",
    "defaultspack_promotion_eligible": false,
    "owner_surfaces": [
      "agent_workroom_session",
      "run_event_log",
      "task_plan_contract",
      "progress_event_contract",
      "checkpoint_resume_contract",
      "interrupt_redirect_cancel_contract",
      "deterministic_replay_index",
      "run_board_ui_contract"
    ],
    "non_owner_surfaces": [
      "tool execution",
      "browser action",
      "desktop action",
      "schedule execution",
      "file persistence",
      "metrics collection",
      "subagent PR management",
      "model routing"
    ],
    "optional_integrations": [
      {
        "pack_id": "rumi_default_tools_pack",
        "reason": "Owns concrete tool execution plus browser and desktop actions after the workroom emits approved handoff packets."
      },
      {
        "pack_id": "defaultspack",
        "reason": "Owns scheduler wakeups, durable run-adjacent persistence, and metrics receipts."
      },
      {
        "pack_id": "rumi_operations_company_pack",
        "reason": "Owns adjacent agent-service choreography and cross-worker PR/status orchestration after the workroom emits approved handoff packets."
      },
      {
        "pack_id": "rumi_model_catalog_pack",
        "reason": "Owns model availability and model-routing policy."
      }
    ],
    "asset_index": {
      "index": [
        "asset_index.json",
        "asset_index.yaml"
      ],
      "readme": [
        "README.md"
      ],
      "docs": [
        "docs/README.md",
        "docs/architecture.md",
        "docs/compatibility.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ],
      "catalog": [
        "catalog/handoff_matrix.yaml",
        "catalog/quality_matrix.yaml",
        "catalog/taxonomy.yaml",
        "catalog/workflows.yaml"
      ],
      "policy": [
        "policies/handoff.policy.yaml",
        "policies/safety.policy.yaml"
      ],
      "checklist": [
        "checklists/review.checklist.yaml"
      ],
      "ledger": [
        "ledgers/evidence_ledger.schema.yaml"
      ],
      "template": [
        "templates/handoff.template.md",
        "templates/review_report.template.md",
        "templates/ui_contract.template.md"
      ],
      "fixtures": [
        "fixtures/contract_fixture.yaml",
        "fixtures/negative_cases.yaml"
      ],
      "presets": [
        "presets/handoff_review.preset.yaml",
        "presets/quality_gate.preset.yaml",
        "presets/safe_default.preset.yaml"
      ],
      "schema": [
        "schemas/agent_run.schema.json",
        "schemas/checkpoint.schema.json",
        "schemas/control_request.schema.json",
        "schemas/handoff_envelope.schema.json",
        "schemas/intervention.schema.json",
        "schemas/progress_event.schema.json",
        "schemas/replay_index.schema.json",
        "schemas/run_board_view.schema.json",
        "schemas/run_event.schema.json",
        "schemas/task_plan.schema.json",
        "schemas/workroom_session.schema.json"
      ],
      "profiles": [
        "profiles/workroom_operator.profile.yaml"
      ],
      "prompts": [
        "prompts/workroom_orchestrator.system.md"
      ],
      "frontend": [
        "frontend_extensions/run_board.ui.json"
      ],
      "example": [
        "examples/checkpoint_resume.example.yaml",
        "examples/redirect_running_plan.example.yaml",
        "examples/replay_divergence.example.yaml",
        "examples/run_board_review.example.yaml"
      ]
    }
  }
}
