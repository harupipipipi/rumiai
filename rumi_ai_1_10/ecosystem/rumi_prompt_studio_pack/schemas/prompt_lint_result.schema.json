{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rumi.local/schemas/prompt_studio/prompt_lint_result.schema.json",
  "title": "Prompt Studio Lint Result",
  "type": "object",
  "required": [
    "prompt_artifact_id",
    "rubric_id",
    "status",
    "criterion_results",
    "blocking_failures",
    "fixture_evidence",
    "handoff_required"
  ],
  "properties": {
    "prompt_artifact_id": {
      "type": "string"
    },
    "rubric_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_notes",
        "needs_revision",
        "blocked"
      ]
    },
    "criterion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "result",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "note",
              "fail"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "blocking_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "expected_traits",
          "observed_summary"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "expected_traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "handoff_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface",
          "owner_pack",
          "reason"
        ],
        "properties": {
          "surface": {
            "type": "string"
          },
          "owner_pack": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
