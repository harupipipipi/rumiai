{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rumi.local/schemas/prompt_studio/instruction_migration_record.schema.json",
  "title": "Prompt Studio Instruction Migration Record",
  "type": "object",
  "required": [
    "id",
    "source_platform",
    "source_fixture_ref",
    "target_prompt_artifact_id",
    "portable_instructions",
    "platform_specific_notes",
    "blocked_imports",
    "clarifying_questions",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source_platform": {
      "type": "string",
      "enum": [
        "claude",
        "chatgpt",
        "gemini"
      ]
    },
    "source_fixture_ref": {
      "type": "string"
    },
    "target_prompt_artifact_id": {
      "type": "string"
    },
    "portable_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "platform_specific_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "reason"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_revision",
        "approved_for_prompt_artifact"
      ]
    }
  },
  "additionalProperties": false
}
