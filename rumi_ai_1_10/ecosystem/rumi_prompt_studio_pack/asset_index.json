{
  "pack_id": "rumi_prompt_studio_pack",
  "version": "0.1.0",
  "asset_groups": {
    "docs": {
      "purpose": "Human operating guide and boundary documentation.",
      "paths": [
        "README.md",
        "docs/README.md",
        "docs/architecture.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ]
    },
    "catalog": {
      "purpose": "Prompt, lint, migration, style, and local dry-run declarations.",
      "paths": [
        "catalog/prompt_library.yaml",
        "catalog/prompt_lint_rubrics.yaml",
        "catalog/custom_instruction_migration_map.yaml",
        "catalog/style_persona_catalog.yaml",
        "catalog/local_fixture_dry_runs.yaml"
      ]
    },
    "schemas": {
      "purpose": "Portable JSON contracts for prompt artifacts, migration records, and lint results.",
      "paths": [
        "schemas/prompt_artifact.schema.json",
        "schemas/instruction_migration_record.schema.json",
        "schemas/prompt_lint_result.schema.json"
      ]
    },
    "review_controls": {
      "purpose": "Policies, checklists, ledgers, and templates for prompt review.",
      "paths": [
        "policies/prompt_studio_review.policy.yaml",
        "policies/custom_instruction_migration.policy.yaml",
        "checklists/prompt_release.checklist.yaml",
        "ledgers/prompt_studio_review_ledger.schema.yaml",
        "templates/prompt_review_report.template.yaml",
        "templates/custom_instruction_migration.template.yaml"
      ]
    },
    "fixtures": {
      "purpose": "Local-only dry-run inputs for migration and prompt lint smoke checks.",
      "paths": [
        "fixtures/chatgpt_custom_instructions.fixture.md",
        "fixtures/claude_project_instructions.fixture.md",
        "fixtures/gemini_gem_instruction.fixture.md",
        "fixtures/local_dry_run_cases.yaml"
      ]
    },
    "prompt_surfaces": {
      "purpose": "Reusable reviewer profiles, system prompts, style presets, and examples.",
      "paths": [
        "profiles/prompt_librarian.profile.yaml",
        "profiles/instruction_migration_reviewer.profile.yaml",
        "prompts/prompt_librarian.system.md",
        "prompts/instruction_migration_reviewer.system.md",
        "presets/concise_operator.preset.yaml",
        "presets/warm_research_partner.preset.yaml",
        "presets/code_review_senior.preset.yaml",
        "presets/technical_writer_plain.preset.yaml",
        "examples/prompt_library_entry.example.yaml",
        "examples/chatgpt_instruction_migration.example.yaml",
        "examples/claude_instruction_migration.example.yaml",
        "examples/local_fixture_dry_run.example.yaml"
      ]
    }
  },
  "non_executable_statement": "This index references prompt artifacts and review rules only. It does not register tools, APIs, model routers, memory stores, or executable runtimes."
}
