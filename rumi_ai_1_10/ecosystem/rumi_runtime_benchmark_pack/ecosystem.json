{
  "pack_id": "rumi_runtime_benchmark_pack",
  "pack_identity": "rumi:ecosystem/rumi_runtime_benchmark_pack",
  "display_name": "Rumi Runtime Benchmark Pack",
  "description": "Declarative runtime benchmark, latency, cost, reproducibility, sampling, environment-capture, and tool-loop measurement pack.",
  "version": "0.1.0",
  "license": "MIT",
  "vocabulary": {
    "types": [
      "catalog",
      "schema",
      "spec",
      "policy",
      "coordination",
      "profile",
      "prompt",
      "preset",
      "example"
    ]
  },
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "components": {},
  "load_order": [],
  "required_secrets": [],
  "required_network": [],
  "metadata": {
    "runtime_type": "declarative_pack",
    "network_policy": "none_by_default",
    "executable_code": false,
    "required_secrets": [],
    "owner_surfaces": [
      "latency_measurement",
      "cost_snapshot",
      "tool_loop_reproducibility",
      "runtime_comparison",
      "sampling_plan",
      "environment_capture",
      "multi_pass_specialist_review"
    ],
    "optional_integrations": [
      {
        "pack_id": "rumi_model_evals_pack",
        "reason": "Model evals pack owns model-quality scoring beyond runtime measurement."
      },
      {
        "pack_id": "rumi_observability_pack",
        "reason": "Observability pack owns production telemetry and run-event logging."
      },
      {
        "pack_id": "rumi_sandbox_runtime_pack",
        "reason": "Sandbox runtime pack owns isolated execution environment provisioning."
      },
      {
        "pack_id": "rumi_devops_release_pack",
        "reason": "DevOps release pack owns release-gate and deployment evidence reporting."
      }
    ],
    "asset_index": {
      "catalog": [
        "catalog/runtime_benchmark_matrix.yaml",
        "catalog/environment_capture_schema.json",
        "catalog/latency_cost_sampling_matrix.yaml",
