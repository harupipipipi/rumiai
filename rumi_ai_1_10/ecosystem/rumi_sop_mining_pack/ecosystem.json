{
  "pack_id": "rumi_sop_mining_pack",
  "pack_identity": "rumi:ecosystem/rumi_sop_mining_pack",
  "display_name": "Rumi SOP Mining Pack",
  "description": "Declarative pack for turning local chat, tool, and audit traces into repeatable SOPs, checklists, runbooks, and human-approved workflow recipes.",
  "version": "0.1.0",
  "license": "MIT",
  "vocabulary": {
    "types": [
      "catalog",
      "schema",
      "policy",
      "runbook",
      "checklist",
      "ledger",
      "profile",
      "prompt",
      "preset",
      "example",
      "documentation"
    ]
  },
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "components": {},
  "load_order": [],
  "required_secrets": [],
  "required_network": [],
  "metadata": {
    "runtime_type": "declarative_pack",
    "network_policy": "none_by_default",
    "executable_code": false,
    "declarative_only": true,
    "required_secrets": [],
    "owner_surfaces": [
      "sop_pattern_catalog",
      "trace_record_schema",
      "redaction_policy",
      "human_approval_policy",
      "non_execution_boundary",
      "runbook_template",
      "review_checklist",
      "sop_mining_ledger",
      "workflow_recipe_catalog",
      "evidence_source_catalog"
    ],
    "excluded_surfaces": [
      "automation_execution",
      "browser_control",
      "computer_control",
      "scheduled_jobs",
      "tool_creation",
      "live_trace_capture",
      "external_message_delivery"
    ],
    "optional_integrations": [
      {
        "pack_id": "rumi_observability_pack",
        "reason": "Observability owns durable trace capture and run-event storage. This pack consumes already available trace references."
      },
      {
        "pack_id": "rumi_browser_automation_pack",
        "reason": "Browser automation owns live browser control and replay. This pack may document a browser-derived SOP only from completed evidence."
      },
      {
        "pack_id": "rumi_default_tools_pack",
        "reason": "Tool creation and invocation stay with tool-owner packs. This pack documents manual recipe patterns."
      },
      {
        "pack_id": "defaultspack",
        "reason": "defaultspack remains the runtime owner for approvals, tools, scheduler, and computer-use surfaces."
      }
    ],
    "asset_index": {
      "catalog": [
        "catalog/sop_pattern_catalog.yaml",
        "catalog/trace_source_catalog.yaml",
        "catalog/workflow_recipe_catalog.yaml"
      ],
      "schemas": [
        "schemas/trace_record.schema.json",
        "schemas/sop_record.schema.json"
      ],
      "policies": [
        "policies/redaction.policy.yaml",
        "policies/human_approval.policy.yaml",
        "policies/non_execution_boundary.policy.yaml"
      ],
      "runbooks": [
        "runbooks/sop_mining_runbook.template.yaml"
      ],
      "checklists": [
        "checklists/sop_mining_review.checklist.yaml"
      ],
      "ledgers": [
        "ledgers/sop_mining_ledger.schema.yaml"
      ],
      "profiles": [
        "profiles/sop_mining_reviewer.profile.yaml"
      ],
      "prompts": [
        "prompts/sop_mining_reviewer.system.md",
        "prompts/redaction_reviewer.system.md"
      ],
      "presets": [
        "presets/safe_default.preset.yaml",
        "presets/handoff_review.preset.yaml",
        "presets/quality_gate.preset.yaml"
      ],
      "examples": [
        "examples/chat_to_sop.example.yaml",
        "examples/tool_trace_to_runbook.example.yaml",
        "examples/audit_trace_to_checklist.example.yaml",
        "examples/human_approved_recipe.example.yaml"
      ],
      "docs": [
        "README.md",
        "docs/README.md",
        "docs/architecture.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ]
    }
  }
}
