    "supported": true,
    "levels": [
      "low",
      "medium",
      "high",
      "xhigh"
    ],
    "default_level": "high",
    "provider_mapping": {
      "low": {
        "reasoning": {
          "effort": "low"
        }
      },
      "medium": {
        "reasoning": {
          "effort": "medium"
        }
      },
      "high": {
        "reasoning": {
          "effort": "high"
        }
      },
      "xhigh": {
        "reasoning": {
          "effort": "high"
        }
      },
      "none": {}
    }
  },
  "metadata": {
    "source": "openrouter_curated_allowlist",
    "input_modalities": [
      "text",
      "file",
      "image"
    ],
    "output_modalities": [
      "text"
    ],
    "max_output_tokens": 100000,
    "unsupported_input_modalities": [
      "file"
    ],
    "supported_parameters": [
      "include_reasoning",
      "max_tokens",
      "reasoning",
      "response_format",
      "seed",
      "structured_outputs",
      "tool_choice",
      "tools"
    ]
  },
  "pricing": {
    "prompt": "0.00002",
    "completion": "0.00008"
  }
