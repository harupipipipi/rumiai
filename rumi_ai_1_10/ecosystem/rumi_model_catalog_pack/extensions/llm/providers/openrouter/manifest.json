{
  "id": "openrouter",
  "category": "llm_provider",
  "version": "1",
  "display_name": "OpenRouter",
  "enabled": true,
  "priority": 40,
  "adapter": "python_entrypoint",
  "entrypoint": "domain.ai_client.providers.openrouter_provider:OpenRouterProvider",
  "api_key_env": "OPENROUTER_API_KEY",
  "base_url_env": "OPENROUTER_BASE_URL",
  "credential_required": true,
  "default_model": "cohere/north-mini-code:free",
  "default_model_for": {
    "chat": "cohere/north-mini-code:free",
    "fast": "cohere/north-mini-code:free",
    "cheap": "cohere/north-mini-code:free",
    "general": "anthropic/claude-sonnet-5",
    "reasoning": "deepseek/deepseek-r1-0528",
    "coding": "qwen/qwen3-coder-next",
    "agent": "moonshotai/kimi-k2.7-code",
    "vision": "google/gemini-2.5-pro",
    "legacy": "tencent/hy3-preview:free"
  },
  "capabilities": {
    "native_tool_calling": true,
    "structured_outputs": true,
    "vision": true,
    "embeddings": false,
    "reasoning": true,
    "streaming": true
  },
  "config": {
    "model_sync": "bundled_catalog_allowlist",
    "model_list_path": "/models"
  }
}
