{
  "id": "anthropic",
  "category": "llm_provider",
  "version": "1",
  "display_name": "Anthropic",
  "enabled": true,
  "priority": 20,
  "adapter": "python_entrypoint",
  "entrypoint": "domain.ai_client.providers.anthropic_provider:AnthropicProvider",
  "api_key_env": "ANTHROPIC_API_KEY",
  "credential_required": true,
  "default_model_for": {
    "chat": "claude-sonnet-4-6",
    "fast": "claude-sonnet-4-6",
    "large": "claude-opus-4-6"
  },
  "catalog_features": [
    "chat",
    "streaming",
    "tool_calls",
    "vision"
  ],
  "api_surface": {
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "image_url",
      "tool_call",
      "tool_result"
    ],
    "supports_tool_call_shape": true,
    "schema_support": {
      "json_schema": false
    }
  }
}
