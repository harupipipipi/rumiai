{
  "id": "nvidia",
  "category": "llm_provider",
  "version": "1",
  "display_name": "NVIDIA NIM",
  "enabled": true,
  "priority": 60,
  "adapter": "openai_compatible",
  "api_key_env": [
    "NVIDIA_API_KEY",
    "NGC_API_KEY"
  ],
  "base_url_env": "NVIDIA_BASE_URL",
  "credential_required": true,
  "catalog_only": false,
  "supports_invoke": true,
  "default_base_url": "https://integrate.api.nvidia.com/v1",
  "default_model": "nvidia/llama-3.3-nemotron-super-49b-v1",
  "default_model_for": {
    "chat": "nvidia/llama-3.3-nemotron-super-49b-v1",
    "reasoning": "nvidia/llama-3.3-nemotron-super-49b-v1",
    "general": "meta/llama-3.3-70b-instruct",
    "fast": "nvidia/nvidia-nemotron-nano-9b-v2",
    "coding": "qwen/qwen3-coder-480b-a35b-instruct"
  },
  "config": {
    "api_compatibility": "openai",
    "source_docs": "nvidia_nim_llm_apis",
    "model_sync": "fixed_allowlist"
  },
  "catalog_features": [
    "chat",
    "streaming",
    "tool_calls",
    "reasoning",
    "openai_compatible"
  ],
  "api_surface": {
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "tool_call",
      "tool_result"
    ],
    "supports_tool_call_shape": true,
    "schema_support": {
      "json_schema": false
    }
  }
}
