{
  "id": "openai",
  "category": "llm_provider",
  "version": "1",
  "display_name": "OpenAI",
  "description": "Official OpenAI provider adapter.",
  "enabled": true,
  "priority": 10,
  "adapter": "python_entrypoint",
  "entrypoint": "domain.ai_client.providers.openai_provider:OpenAIProvider",
  "api_key_env": "OPENAI_API_KEY",
  "base_url_env": "OPENAI_BASE_URL",
  "credential_required": true,
  "default_model_for": {
    "chat": "gpt-5.5",
    "fast": "gpt-5.5-mini",
    "large": "gpt-5.5",
    "embedding": "text-embedding-3-large"
  },
  "catalog_features": [
    "chat",
    "streaming",
    "tool_calls",
    "vision",
    "embedding"
  ]
}
