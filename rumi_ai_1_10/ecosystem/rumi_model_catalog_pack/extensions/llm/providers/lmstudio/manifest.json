{
  "id": "lmstudio",
  "category": "llm_provider",
  "version": "2",
  "display_name": "LM Studio",
  "description": "Local LM Studio server with native installed-model discovery and OpenAI-compatible inference.",
  "enabled": true,
  "priority": 150,
  "adapter": "python_entrypoint",
  "entrypoint": "domain.ai_client.providers.lmstudio_provider:LMStudioProvider",
  "api_key_env": [
    "LMSTUDIO_API_TOKEN",
    "LM_API_TOKEN"
  ],
  "base_url_env": "LMSTUDIO_BASE_URL",
  "default_base_url": "http://127.0.0.1:1234/v1",
  "credential_required": false,
  "catalog_only": false,
  "supports_invoke": true,
  "config": {
    "api_compatibility": "openai",
    "model_sync": "lmstudio_native",
    "model_list_path": "/api/v1/models",
    "model_load_path": "/api/v1/models/load",
    "model_unload_path": "/api/v1/models/unload",
    "management_base_url_env": "LMSTUDIO_SERVER_URL",
    "model_cache_ttl_seconds": 60,
    "source_docs": "https://lmstudio.ai/docs/developer/rest/list"
  }
}
