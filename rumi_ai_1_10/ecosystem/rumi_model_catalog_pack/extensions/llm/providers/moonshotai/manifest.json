{
  "id": "moonshotai",
  "category": "llm_provider",
  "version": "1",
  "display_name": "Moonshot AI",
  "enabled": true,
  "priority": 65,
  "adapter": "openai_compatible",
  "api_key_env": "MOONSHOT_API_KEY",
  "base_url_env": "MOONSHOT_BASE_URL",
  "credential_required": true,
  "catalog_only": false,
  "supports_invoke": true,
  "default_base_url": "https://api.moonshot.ai/v1",
  "default_model": "kimi-k2-0711-preview",
  "default_model_for": {
    "chat": "kimi-k2-0711-preview",
    "coding": "kimi-k2-0711-preview",
    "agent": "kimi-k2-0711-preview",
    "legacy": "moonshot-v1-8k"
  },
  "config": {
    "api_compatibility": "openai",
    "model_sync": "fixed_allowlist",
    "official_model_ids_need_refresh": true
  },
  "catalog_features": [
    "chat",
    "streaming",
    "tool_calls",
    "reasoning",
    "openai_compatible"
  ],
  "api_surface": {
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "tool_call",
      "tool_result"
    ],
    "supports_tool_call_shape": true,
    "schema_support": {
      "json_schema": true
    }
  }
}
