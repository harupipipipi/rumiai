{
  "id": "google",
  "category": "llm_provider",
  "version": "1",
  "display_name": "Google",
  "enabled": true,
  "priority": 30,
  "adapter": "python_entrypoint",
  "entrypoint": "domain.ai_client.providers.google_provider:GoogleProvider",
  "api_key_env": [
    "GOOGLE_API_KEY",
    "GEMINI_API_KEY"
  ],
  "credential_required": true,
  "default_model_for": {
    "chat": "gemini-2.5-pro",
    "fast": "gemini-2.5-flash",
    "large": "gemini-2.5-pro",
    "embedding": "gemini-embedding-001"
  },
  "catalog_features": [
    "chat",
    "streaming",
    "tool_calls",
    "vision",
    "embedding"
  ],
  "api_surface": {
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "image_url",
      "tool_call",
      "tool_result"
    ],
    "supports_tool_call_shape": true,
    "schema_support": {
      "json_schema": false
    }
  }
}
