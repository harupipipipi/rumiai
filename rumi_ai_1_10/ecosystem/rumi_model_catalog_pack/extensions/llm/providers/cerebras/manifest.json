{
  "id": "cerebras",
  "category": "llm_provider",
  "version": "1",
  "display_name": "Cerebras",
  "enabled": true,
  "priority": 55,
  "adapter": "openai_compatible",
  "api_key_env": "CEREBRAS_API_KEY",
  "base_url_env": "CEREBRAS_BASE_URL",
  "credential_required": true,
  "catalog_only": false,
  "supports_invoke": true,
  "default_base_url": "https://api.cerebras.ai/v1",
  "default_model": "gpt-oss-120b",
  "default_model_for": {
    "chat": "gpt-oss-120b",
    "reasoning": "gpt-oss-120b",
    "general": "qwen-3-235b-a22b-instruct-2507",
    "fast": "llama3.1-8b",
    "coding": "zai-glm-4.7",
    "agent": "zai-glm-4.7"
  },
  "capabilities": {
    "native_tool_calling": true,
    "structured_outputs": true,
    "vision": false,
    "embeddings": false,
    "streaming": true,
    "reasoning": true
  },
  "config": {
    "api_compatibility": "openai",
    "supports_service_tier": true,
    "service_tier_values": ["default", "auto", "flex", "priority"],
    "default_service_tier": "default",
    "priority_tier_private_preview": true,
    "service_tier_request_injection": "explicit_only",
    "model_sync": "fixed_allowlist"
  }
}
