{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/sample_size_plan.schema.json",
  "title": "Sample Size Plan",
  "description": "Contract schema for Sample Size Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "sample_source",
    "minimum_detectable_effect",
    "power_assumption",
    "allocation_ratio",
    "limitations"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_rule",
        "expected_traffic",
        "data_source_state"
      ],
      "properties": {
        "population_rule": {
          "type": "string",
          "minLength": 1
        },
        "expected_traffic": {
          "type": "string",
          "minLength": 1
        },
        "data_source_state": {
          "type": "string",
          "enum": [
            "supplied",
            "estimated",
            "unknown"
          ]
        }
      }
    },
    "minimum_detectable_effect": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "power_assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpha",
        "power",
        "method_note"
      ],
      "properties": {
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "power": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "method_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allocation_ratio": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
