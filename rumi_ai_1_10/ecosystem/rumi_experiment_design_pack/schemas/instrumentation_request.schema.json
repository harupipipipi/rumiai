{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/instrumentation_request.schema.json",
  "title": "Instrumentation Request",
  "description": "Contract schema for Instrumentation Request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "metric_ids",
    "event_contracts",
    "observability_owner",
    "data_analysis_owner",
    "privacy_review_state"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "metric_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "event_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_name",
          "properties",
          "required_before_launch"
        ],
        "properties": {
          "event_name": {
            "type": "string",
            "minLength": 1
          },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_before_launch": {
            "type": "boolean"
          }
        }
      }
    },
    "observability_owner": {
      "type": "string",
      "const": "rumi_observability_pack"
    },
    "data_analysis_owner": {
      "type": "string",
      "const": "rumi_data_analysis_pack"
    },
    "privacy_review_state": {
      "type": "string",
      "enum": [
        "not_needed",
        "needed",
        "completed",
        "unknown"
      ]
    }
  }
}
