{
  "pack_id": "rumi_host_capabilities_pack",
  "pack_identity": "rumi:ecosystem/rumi_host_capabilities_pack",
  "version": "0.1.0",
  "metadata": {
    "name": "Rumi Host Capabilities Pack",
    "description": "Typed local host capability broker for OS-facing Rumi operations.",
    "author": "Rumi AI Team",
    "license": "MIT"
  },
  "depends_on": [
    {
      "pack_id": "defaultspack",
      "version": ">=2.0.0"
    }
  ],
  "security_boundary": {
    "host_executor": true,
    "defaultspack_role": "ui_orchestration_and_authority_only",
    "ordinary_pack_contract": "return_host_intent_json",
    "approval_authority": "core_runtime.authority",
    "approval_token_binding": [
      "operation",
      "args_hash",
      "caller_pack_id",
      "caller_function_id",
      "stream_enabled"
    ],
    "unknown_host_function_policy": "critical_typed_confirmation_once"
  },
  "capabilities": [
    "host.permission.status",
    "host.permission.open_settings",
    "host.intent.execute",
    "host.stream.start",
    "host.stream.stop",
    "host.screen.capture",
    "host.accessibility.read",
    "host.accessibility.mutate",
    "host.input.pointer",
    "host.input.keyboard",
    "host.clipboard.read",
    "host.clipboard.write",
    "host.microphone.capture",
    "host.audio.capture",
    "host.audio.output",
    "host.speech.transcribe",
    "host.speech.synthesize",
    "host.camera.capture",
    "host.file.open_dialog",
    "host.file.read_user_selected",
    "host.file.write_user_selected",
    "host.process.open_url",
    "host.process.launch_app",
    "host.process.exec_guarded"
  ],
  "default_grants": {
    "principal_id": "rumi_host_capabilities_pack",
    "include": "standard_host_permissions",
    "exclude": [
      "host.process.exec_guarded"
    ]
  },
  "host_functions": {
    "host_accessibility_action": {
      "operation": "host.accessibility.mutate",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_accessibility_snapshot": {
      "operation": "host.accessibility.read",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_audio_output": {
      "operation": "host.audio.output",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_camera_capture": {
      "operation": "host.camera.capture",
      "stream": true,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_clipboard_read": {
      "operation": "host.clipboard.read",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_clipboard_write": {
      "operation": "host.clipboard.write",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_file_open_dialog": {
      "operation": "host.file.open_dialog",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_file_read_selected": {
      "operation": "host.file.read_user_selected",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_file_write_selected": {
      "operation": "host.file.write_user_selected",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_input_keyboard": {
      "operation": "host.input.keyboard",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_input_pointer": {
      "operation": "host.input.pointer",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_intent_execute": {
      "operation": "host.intent.execute",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_microphone_capture": {
      "operation": "host.microphone.capture",
      "stream": true,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_permission_open_settings": {
      "operation": "host.permission.open_settings",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_permission_status": {
      "operation": "host.permission.status",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_process_exec_guarded": {
      "operation": "host.process.exec_guarded",
      "stream": true,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_process_launch_app": {
      "operation": "host.process.launch_app",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_process_open_url": {
      "operation": "host.process.open_url",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_screen_capture": {
      "operation": "host.screen.capture",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_speech_synthesize": {
      "operation": "host.speech.synthesize",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_speech_transcribe": {
      "operation": "host.speech.transcribe",
      "stream": true,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_stream_start": {
      "operation": "host.stream.start",
      "stream": true,
      "executor_owner": "rumi_viewer_host_broker"
    },
    "host_stream_stop": {
      "operation": "host.stream.stop",
      "stream": false,
      "executor_owner": "rumi_viewer_host_broker"
    }
  },
  "permission_catalog": "permissions/host_permissions.json",
  "policy": {
    "host_boundary": "policies/host_capability_boundary.policy.yaml",
    "audit": "host_intent_events_only_no_media_payloads"
  },
  "privacy": {
    "store_microphone_audio": false,
    "store_camera_frames": false,
    "store_screen_images": false,
    "audit_payloads": [
      "operation",
      "args_hash",
      "caller_pack_id",
      "caller_function_id",
      "decision",
      "os_permission_status"
    ]
  }
}
