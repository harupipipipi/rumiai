{
  "pack_id": "rumi_frontend_design_pack",
  "pack_identity": "rumi:ecosystem/rumi_frontend_design_pack",
  "display_name": "Rumi Frontend Design Pack",
  "version": "0.1.0",
  "description": "Declarative frontend, UI design, responsive QA, and component acceptance workflow pack.",
  "vocabulary": {
    "types": [
      "frontend_design",
      "catalog",
      "policy",
      "profile",
      "prompt",
      "preset",
      "example",
      "schema",
      "checklist",
      "template"
    ]
  },
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "components": {},
  "load_order": [],
  "metadata": {
    "required_secrets": [],
    "network_policy": "none_by_default",
    "executable_code": false,
    "declarative_only": true,
    "optional_integrations": [
      {
        "pack_id": "rumi_code_ide_pack",
        "reason": "Owns implementation edits, component code changes, and source-file patching."
      },
      {
        "pack_id": "rumi_browser_automation_pack",
        "reason": "Owns browser execution, screenshot capture, viewport replay, and rendered UI inspection."
      },
      {
        "pack_id": "rumi_multimodal_media_pack",
        "reason": "Owns generated or inspected image assets, visual provenance, and media transformations."
      },
      {
        "pack_id": "rumi_workspace_pack",
        "reason": "Owns exportable workspace artifacts, design briefs, and document/deck handoffs."
      }
    ],
    "owner_surfaces": [
      "frontend_briefs",
      "design_system_fit",
      "responsive_visual_qa",
      "component_acceptance_criteria",
      "design_system_fit_rubric",
      "responsive_qa_matrix",
      "component_acceptance_schema",
      "component_acceptance_checklist"
    ],
    "asset_index": {
      "manifest": [
        "ecosystem.json"
      ],
      "readme": [
        "README.md"
      ],
      "docs": [
        "docs/README.md",
        "docs/architecture.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ],
      "catalog": [
        "catalog/frontend_workflows.yaml",
        "catalog/design_system_fit_rubric.yaml",
        "catalog/responsive_qa_matrix.yaml"
      ],
      "policy": [
        "policies/frontend_quality.policy.yaml"
      ],
      "profile": [
        "profiles/frontend_design_reviewer.profile.yaml"
      ],
      "prompt": [
        "prompts/frontend_design_reviewer.system.md"
      ],
      "preset": [
        "presets/safe_default.preset.yaml",
        "presets/handoff_review.preset.yaml",
        "presets/quality_gate.preset.yaml"
      ],
      "example": [
        "examples/component_brief.example.yaml",
        "examples/dashboard_review.example.yaml",
        "examples/mobile_visual_qa.example.yaml"
      ],
      "schema": [
        "schemas/component_acceptance.schema.yaml"
      ],
      "checklist": [
        "checklists/component_acceptance.checklist.yaml"
      ],
      "template": []
    }
  }
}
