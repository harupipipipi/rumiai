{
  "pack_id": "core_control_panel",
  "pack_identity": "core:rumi/control_panel",
  "version": "1.0.0",
  "vocabulary": {
    "types": []
  },
  "metadata": {
    "name": "Core Control Panel",
    "description": "Rumi AI OS core pack that provides the control panel backend API. Dashboard, Pack management, Flow CRUD, settings, and kernel restart endpoints.",
    "author": "Rumi AI Team",
    "license": "MIT",
    "is_core_pack": true
  },
  "dependencies": {},
  "components": {},
  "web_mount": {
    "path_prefix": "/panel",
    "static_root": "web",
    "spa_fallback": true,
    "auth_required": true
  },
  "pre_auth_routes": [
    {
      "method": "POST",
      "path": "/api/panel/auth/bootstrap"
    },
    {
      "method": "POST",
      "path": "/api/panel/auth/exchange"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/api/panel/dashboard",
      "handler": "_panel_get_dashboard"
    },
    {
      "method": "GET",
      "path": "/api/panel/packs",
      "handler": "_panel_get_packs"
    },
    {
      "method": "GET",
      "path": "/api/panel/startup/profiles",
      "handler": "_panel_get_startup_profiles"
    },
    {
      "method": "GET",
      "path": "/api/panel/flows",
      "handler": "_panel_get_flows"
    },
    {
      "method": "GET",
      "path": "/api/panel/nodes",
      "handler": "_panel_get_nodes"
    },
    {
      "method": "GET",
      "path_pattern": "/api/panel/profiles/{id}/nodes",
      "handler": "_panel_get_profile_nodes"
    },
    {
      "method": "GET",
      "path_pattern": "/api/panel/flows/{id}",
      "handler": "_panel_get_flow_detail"
    },
    {
      "method": "GET",
      "path": "/api/panel/settings/profile",
      "handler": "_panel_get_profile"
    },
    {
      "method": "GET",
      "path": "/api/panel/version",
      "handler": "_panel_get_version"
    },
    {
      "method": "POST",
      "path_pattern": "/api/panel/packs/{id}/enable",
      "handler": "_panel_enable_pack"
    },
    {
      "method": "POST",
      "path_pattern": "/api/panel/packs/{id}/disable",
      "handler": "_panel_disable_pack"
    },
    {
      "method": "POST",
      "path": "/api/panel/startup/profiles",
      "handler": "_panel_create_startup_profile",
      "pass_body": true
    },
    {
      "method": "POST",
      "path": "/api/panel/flows",
      "handler": "_panel_create_flow",
      "pass_body": true
    },
    {
      "method": "POST",
      "path_pattern": "/api/panel/startup/profiles/{id}/duplicate",
      "handler": "_panel_duplicate_startup_profile"
    },
    {
      "method": "POST",
      "path_pattern": "/api/panel/startup/profiles/{id}/activate",
      "handler": "_panel_activate_startup_profile"
    },
    {
      "method": "POST",
      "path_pattern": "/api/panel/startup/profiles/{id}/launch",
      "handler": "_panel_launch_startup_profile"
    },
    {
      "method": "POST",
      "path": "/api/panel/kernel/restart",
      "handler": "_panel_restart_kernel",
      "response_mode": "raw"
    },
    {
      "method": "PUT",
      "path_pattern": "/api/panel/startup/profiles/{id}",
      "handler": "_panel_update_startup_profile",
      "pass_body": true
    },
    {
      "method": "DELETE",
      "path_pattern": "/api/panel/startup/profiles/{id}",
      "handler": "_panel_delete_startup_profile"
    },
    {
      "method": "PUT",
      "path_pattern": "/api/panel/flows/{id}",
      "handler": "_panel_update_flow",
      "pass_body": true
    },
    {
      "method": "PUT",
      "path": "/api/panel/settings/profile",
      "handler": "_panel_update_profile",
      "pass_body": true
    },
    {
      "method": "DELETE",
      "path_pattern": "/api/panel/flows/{id}",
      "handler": "_panel_delete_flow"
    }
  ]
}
