{
  "id": "advanced-webapps-suite",
  "purpose": "Dogfood recursive UI generation across advanced commerce, clinical, fintech, and dense admin websites.",
  "density": "compact",
  "implementationMode": "component-with-slots",
  "importance": "pageFrame",
  "responsibilities": {
    "responsiveTopologies": ["advanced-suite-route"]
  },
  "slots": [
    {"id": "commerce", "acceptsNodeId": "commerce-shell", "purpose": "B2B product configurator", "minWidth": 320},
    {"id": "clinical", "acceptsNodeId": "clinical-shell", "purpose": "Clinical intake flow", "minWidth": 320},
    {"id": "fintech", "acceptsNodeId": "fintech-shell", "purpose": "Risk approval workflow", "minWidth": 320},
    {"id": "admin", "acceptsNodeId": "admin-shell", "purpose": "Dense data-grid admin", "minWidth": 320}
  ],
  "children": [
    {
      "id": "commerce-shell",
      "purpose": "Configure products while keeping quote and compatibility evidence readable.",
      "density": "compact",
      "implementationMode": "component-with-slots",
      "importance": "pageFrame",
      "responsibilities": {
        "responsiveTopologies": ["commerce-desktop-three-region", "commerce-mobile-step-route"]
      },
      "slots": [
        {"id": "gallery", "acceptsNodeId": "product-gallery", "purpose": "Variant gallery", "minWidth": 280},
        {"id": "options", "acceptsNodeId": "option-matrix", "purpose": "Configuration controls", "minWidth": 320},
        {"id": "compatibility", "acceptsNodeId": "compatibility-alerts", "purpose": "Compatibility proof", "minWidth": 280},
        {"id": "quote", "acceptsNodeId": "quote-summary", "purpose": "Price and stock summary", "minWidth": 280},
        {"id": "checkout", "acceptsNodeId": "checkout-cta", "purpose": "Purchase action", "minWidth": 240}
      ],
      "children": [
        {
          "id": "product-gallery",
          "purpose": "Show product variants, stock badges, and image order.",
          "importance": "primaryRegion",
          "responsibilities": {
            "visualRoles": ["variant-card", "stock-badge", "selection-marker"],
            "controls": ["variant-select", "image-zoom"],
            "states": ["default", "selected", "low-stock"],
            "responsiveTopologies": ["gallery-scroll"]
          },
          "requiredStates": ["default", "selected", "low-stock"],
          "allowedPrimitives": ["Surface", "Badge", "Button"],
          "visibleActionBudget": 2
        },
        {
          "id": "option-matrix",
          "purpose": "Configure model, storage, warranty, and service options without toolbar overload.",
          "importance": "primaryRegion",
          "responsibilities": {
            "visualRoles": ["option-group", "price-delta", "availability-note"],
            "controls": ["model", "storage", "warranty", "service-plan"],
            "states": ["default", "changed", "invalid-combination"],
            "responsiveTopologies": ["option-stepper"]
          },
          "inputs": ["model"],
          "events": ["onModelChange"],
          "requiredStates": ["default", "changed", "invalid-combination"],
          "allowedPrimitives": ["Button", "SegmentedControl", "Select", "InlineAlert"],
          "visibleActionBudget": 4
        },
        {
          "id": "compatibility-alerts",
          "purpose": "Explain impossible combinations and recovery paths.",
          "importance": "secondaryRegion",
          "responsibilities": {
            "visualRoles": ["alert", "recovery-action"],
            "controls": ["fix-option"],
            "states": ["clear", "warning", "blocking"],
            "responsiveTopologies": ["alert-stack"]
          },
          "requiredStates": ["clear", "warning", "blocking"],
          "allowedPrimitives": ["InlineAlert", "Button"],
          "visibleActionBudget": 2
        },
        {
          "id": "quote-summary",
          "purpose": "Keep subtotal, lead time, stock, and approval readiness visible.",
          "importance": "primaryRegion",
          "responsibilities": {
            "visualRoles": ["price-total", "lead-time", "approval-status"],
            "controls": ["save-quote", "refresh-stock"],
            "states": ["default", "stale", "ready"],
            "responsiveTopologies": ["sticky-quote"]
          },
          "requiredStates": ["default", "stale", "ready"],
          "allowedPrimitives": ["Surface", "Badge", "Button"],
          "visibleActionBudget": 2
        },
        {
          "id": "checkout-cta",
          "purpose": "Submit checkout or saved quote only after compatibility passes.",
          "importance": "primaryRegion",
          "responsibilities": {
            "visualRoles": ["primary-cta", "readiness-copy"],
            "controls": ["checkout", "request-approval"],
            "mutations": ["submit-checkout"],
            "states": ["locked", "ready", "submitting"],
            "responsiveTopologies": ["cta-bar"]
          },
          "requiredStates": ["locked", "ready", "submitting"],
          "allowedPrimitives": ["Button", "InlineAlert"],
          "visibleActionBudget": 2
        }
      ]
    },
    {
