{
  "pack_id": "rust_example_pack",
  "pack_identity": "examples:rumi/rust-example-pack",
  "version": "0.1.0",
  "metadata": {
    "name": "Rust Example Pack",
    "description": "Rumi AI OS の Rust Pack サンプル。Hello 機能と KV Store 機能を提供します。",
    "author": "Rumi AI Team",
    "license": "MIT",
    "is_core_pack": false
  },
  "vocabulary": {
    "types": []
  },
  "dependencies": {},
  "components": {},
  "runtime": {
    "type": "binary",
    "build": {
      "command": "cargo build --release",
      "output": "target/release/rust_example_pack"
    }
  },
  "functions": {
    "hello": {
      "description": "名前を受け取り挨拶を返す",
      "runtime": "binary",
      "main": "target/release/rust_example_pack",
      "calling_convention": "binary",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "挨拶する相手の名前（省略時: World）"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "greeted_by": { "type": "string" },
          "principal": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      },
      "tags": ["example", "hello", "rust"],
      "grant_config": {
        "timeout": 30
      }
    },
    "kv_store": {
      "description": "キー-バリューストア操作（set/get/delete/list）",
      "runtime": "binary",
      "main": "target/release/rust_example_pack",
      "calling_convention": "binary",
      "input_schema": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["set", "get", "delete", "list"],
            "description": "実行するアクション"
          },
          "key": {
            "type": "string",
            "description": "キー（set/get/delete 時に必要）"
          },
          "value": {
            "description": "値（set 時に必要）"
          }
        }
      },
      "tags": ["example", "kv", "rust"],
      "grant_config": {
        "timeout": 30
      }
    }
  }
}
