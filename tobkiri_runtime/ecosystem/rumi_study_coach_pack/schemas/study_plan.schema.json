{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/study_plan.schema.json",
  "title": "Study Plan",
  "description": "Contract schema for Study Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "study_goal_id",
    "sessions",
    "review_windows",
    "source_note_ids",
    "scheduler_handoff"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "study_goal_id": {
      "type": "string",
      "minLength": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "focus_skill",
          "duration_minutes",
          "practice_mode",
          "evidence_ids"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "focus_skill": {
            "type": "string",
            "minLength": 1
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 180
          },
          "practice_mode": {
            "type": "string",
            "enum": [
              "read",
              "quiz",
              "teach_back",
              "mixed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "review_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_id",
          "earliest_review",
          "latest_review",
          "reason"
        ],
        "properties": {
          "queue_id": {
            "type": "string",
            "minLength": 1
          },
          "earliest_review": {
            "type": "string",
            "minLength": 1
          },
          "latest_review": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_note_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scheduler_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_required",
        "owner_pack",
        "human_review_required"
      ],
      "properties": {
        "handoff_required": {
          "type": "boolean"
        },
        "owner_pack": {
          "type": "string",
          "const": "rumi_workflow_scheduler_pack"
        },
        "human_review_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
