{
  "id": "longcat",
  "category": "llm_provider",
  "version": "1",
  "display_name": "Longcat",
  "enabled": true,
  "priority": 100,
  "adapter": "openai_compatible",
  "api_key_env": "LONGCAT_API_KEY",
  "base_url_env": "LONGCAT_BASE_URL",
  "default_base_url": "https://api.longcat.chat/openai/v1",
  "credential_required": true,
  "default_model": "LongCat-Flash-Chat",
  "models": [
    {
      "model_id": "LongCat-Flash-Chat",
      "display_name": "LongCat Flash Chat",
      "type": "chat",
      "defaults": {
        "chat": true,
        "fast": true
      },
      "metadata": {
        "docs": "https://longcat.chat/platform/docs/"
      }
    }
  ]
}
