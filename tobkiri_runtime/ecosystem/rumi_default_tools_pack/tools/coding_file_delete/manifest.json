{
  "id": "coding_file_delete",
  "category": "tool",
  "version": "1",
  "display_name": "Delete File",
  "description": "Delete a workspace file after approval.",
  "enabled": true,
  "config": {
    "name": "coding_file_delete",
    "summary": "Delete a workspace file",
    "tags": ["coding", "file", "delete"],
    "ui": {
      "group_id": "coding/files/write",
      "group_label": "Write",
      "group_icon": "file",
      "drop_capabilities": ["composer.toggle_chip"],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {"id": "approval_policy", "label": "Approval Policy", "type": "select", "default": "prompt", "options": [{"value": "prompt", "label": "Prompt"}, {"value": "always_require", "label": "Always Require"}]},
        {"id": "default_workspace_root", "label": "Default Workspace Root", "type": "text", "default": "", "help": "Durable root used when a workspace root is not provided by the runtime."},
        {"id": "preflight_by_default", "label": "Preflight By Default", "type": "toggle", "default": true}
      ]
    },
    "tool_category": "filesystem_write",
    "action_type": "delete",
    "risk": "high",
    "approval_policy": "ask",
    "capability_grants": ["file.write"],
    "write_action": true,
    "requires_approval": true,
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string"}
        },
        "required": ["path"]
      }
    },
    "execution": {"type": "rumi_function", "qualified_name": "defaultspack:coding_file_delete"}
  }
}
