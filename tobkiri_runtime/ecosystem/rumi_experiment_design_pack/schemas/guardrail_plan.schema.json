{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/guardrail_plan.schema.json",
  "title": "Guardrail Plan",
  "description": "Contract schema for Guardrail Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guardrail_plan_id",
    "metrics",
    "rollback_thresholds",
    "monitoring_owner",
    "stop_rules",
    "human_review_required"
  ],
  "properties": {
    "guardrail_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_name",
          "threshold",
          "direction",
          "source_state"
        ],
        "properties": {
          "metric_name": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "source_state": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rollback_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "owner_pack",
          "action_label"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "owner_pack": {
            "type": "string",
            "const": "defaultspack"
          },
          "action_label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "monitoring_owner": {
      "type": "string",
      "const": "defaultspack"
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    }
  }
}
