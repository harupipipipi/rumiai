    "optional_integrations": [
      {
        "pack_id": "rumi_workspace_pack",
        "reason": "Workspace pack owns generated documents, sheets, slides, and export-ready artifacts."
      },
      {
        "pack_id": "rumi_research_pack",
        "reason": "Research pack owns external-source research beyond local document evidence."
      },
      {
        "pack_id": "rumi_multimodal_media_pack",
