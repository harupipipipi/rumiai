{
  "pack_id": "rumi_document_intelligence_pack",
  "pack_identity": "rumi:ecosystem/rumi_document_intelligence_pack",
  "display_name": "Rumi Document Intelligence Pack",
  "description": "Declarative PDF, contract, citation, redline, page-span, and privacy-aware document review workflow pack.",
  "version": "0.1.0",
  "license": "MIT",
  "vocabulary": {
    "types": [
      "catalog",
      "schema",
      "policy",
      "coordination",
      "profile",
      "prompt",
      "preset",
      "example"
    ]
  },
  "dependencies": {
