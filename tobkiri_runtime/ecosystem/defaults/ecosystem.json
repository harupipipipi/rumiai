  },
  "pack_id": "defaults",
  "pack_identity": "github:harupipipipi/rumiai-defaults",
  "version": "1.0.0",
  "vocabulary": {
    "types": [
      "chat",
      "agent",
      "coding",
      "ai_client",
      "tool",
      "prompt",
      "memory",
      "knowledge",
      "media",
      "frontend",
      "dev"
