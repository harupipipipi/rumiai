{
  "capabilities": [
    "host.permission.status",
    "host.permission.open_settings"
  ],
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "metadata": {
    "author": "Rumi AI Team",
    "description": "Typed local host capability broker for OS-facing Rumi operations.",
    "legacy_annotations": {
      "default_grants": {
        "exclude": [],
        "include": "implemented_host_permissions",
        "principal_id": "rumi_host_capabilities_pack"
      },
      "host_functions": {
        "host_permission_open_settings": {
          "executor_owner": "tobkiri_launcher_host_broker",
          "operation": "host.permission.open_settings",
          "stream": false
        },
        "host_permission_status": {
          "executor_owner": "tobkiri_launcher_host_broker",
          "operation": "host.permission.status",
          "stream": false
        }
      },
      "permission_catalog": "permissions/host_permissions.json",
      "policy": {
        "audit": "host_intent_events_only_no_media_payloads",
        "host_boundary": "policies/host_capability_boundary.policy.yaml"
      },
      "privacy": {
        "audit_payloads": [
          "operation",
          "args_hash",
          "caller_pack_id",
          "caller_function_id",
          "decision",
          "os_permission_status"
        ],
        "store_camera_frames": false,
        "store_microphone_audio": false,
        "store_screen_images": false
      },
      "security_boundary": {
        "approval_authority": "core_runtime.authority",
        "approval_token_binding": [
          "operation",
          "args_hash",
          "caller_pack_id",
          "caller_function_id",
          "stream_enabled"
        ],
        "defaultspack_role": "ui_orchestration_and_authority_only",
        "host_executor": true,
        "ordinary_pack_contract": "return_host_intent_json",
        "unknown_host_function_policy": "critical_typed_confirmation_once"
      }
    },
    "license": "MIT",
    "name": "Rumi Host Capabilities Pack"
  },
  "pack_id": "rumi_host_capabilities_pack",
  "pack_identity": "rumi:ecosystem/rumi_host_capabilities_pack",
  "version": "0.1.0",
  "vocabulary": {
    "types": [
      "service"
    ]
  }
}
