      "transcription_consent",
      "notification_consent",
      "mobile_action_safety",
      "handoff_receipts"
    ],
    "asset_index": {
      "readme": ["README.md"],
      "docs": [
        "docs/README.md",
        "docs/architecture.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ],
      "catalogs": ["catalog/voice_mobile_workflows.yaml"],
      "policies": [
        "policies/voice_mobile_safety.policy.yaml",
        "policies/transcription_notification_consent.policy.yaml"
