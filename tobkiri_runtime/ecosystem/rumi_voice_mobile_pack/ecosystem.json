      ],
      "specs": [
        "specs/intent_taxonomy.yaml",
        "specs/handoff_receipt.schema.yaml"
      ],
      "checklists": ["checklists/mobile_action_safety_checklist.yaml"],
      "templates": ["templates/mobile_handoff_receipt.template.yaml"]
    }
