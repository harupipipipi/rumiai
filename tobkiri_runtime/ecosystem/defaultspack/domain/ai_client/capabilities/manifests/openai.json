{
  "provider_id": "openai",
  "api_surface": {
    "api_family": "openai_chat",
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "image",
      "image_url",
      "audio",
      "input_audio",
      "file",
      "pdf",
      "tool_call",
      "tool_result",
      "reasoning"
    ],
    "supports_tool_call_shape": true,
    "supports_parallel_tool_call_shape": true,
    "tool_choice_modes": [
      "auto",
      "none",
      "required"
    ],
    "schema_support": {
      "json_schema": true,
      "strict_json_schema": true
    },
    "params": {
      "temperature": true,
      "max_tokens": true,
      "max_completion_tokens": true,
      "reasoning_effort": true
    }
  },
  "supported_roles": [
    "system",
    "developer",
    "user",
    "assistant",
    "tool"
  ],
  "quirks": {
    "supports_strict_json_schema": true,
    "supports_builtin_tools": true,
    "supports_mcp_tools": true
  }
}
