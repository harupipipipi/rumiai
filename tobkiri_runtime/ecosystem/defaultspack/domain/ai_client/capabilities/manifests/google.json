{
  "provider_id": "google",
  "api_surface": {
    "api_family": "google_openai",
    "supports_stream": true,
    "accepts_content_blocks": [
      "text",
      "image",
      "image_url",
      "audio",
      "input_audio",
      "tool_call",
      "tool_result",
      "reasoning"
    ],
    "supports_tool_call_shape": true,
    "supports_parallel_tool_call_shape": false,
    "tool_choice_modes": [
      "auto",
      "none"
    ],
    "schema_support": {
      "json_schema": true,
      "strict_json_schema": false
    },
    "params": {
      "temperature": true,
      "max_tokens": true,
      "top_p": true,
      "reasoning_effort": true
    }
  },
  "supported_roles": [
    "system",
    "user",
    "assistant",
    "tool"
  ],
  "quirks": {
    "tool_name_regex": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
    "tool_name_max_length": 128,
    "developer_role_mapping": "system",
    "supports_strict_json_schema": false,
    "supports_stream_usage": true
  }
}
