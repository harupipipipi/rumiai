{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.tobkiri.app.shell.v1",
  "title": "Tobkiri app.shell.v1 provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "kind",
    "presentation_family",
    "presentation_kind",
    "technology",
    "shell_contract",
    "contracts",
    "capabilities",
    "consumes_contracts",
    "approval",
    "variants",
    "production",
    "security"
  ],
  "properties": {
    "schema": {"const": "io.tobkiri.pack.v4"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "version": {"type": "string"},
    "kind": {"const": "shell"},
    "display_name": {"type": "string"},
    "experience_role": {"const": "shell"},
    "presentation_family": {"enum": ["graphical", "terminal", "headless"]},
    "presentation_kind": {"enum": ["declarative", "isolated_web", "packaged_process", "terminal_stdio", "remote_ui"]},
    "technology": {"type": "string"},
    "shell_contract": {"const": "app.shell.v1"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides"],
      "properties": {"provides": {"type": "array", "contains": {"const": "app.shell.v1"}}}
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "consumes_contracts": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provider_trust", "grant_state", "authority_mode", "execution_domain", "effect_scope", "blast_radius"],
      "properties": {
        "state": {"enum": ["verified", "pending", "blocked", "not_required"]},
        "provider_trust": {"enum": ["verified", "pending", "blocked", "not_required"]},
        "grant_state": {"enum": ["not_minted", "available", "missing", "blocked"]},
        "authority_mode": {"enum": ["lease_only", "os_entitlement", "none"]},
        "execution_domain": {"type": "string", "minLength": 1},
        "effect_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blast_radius": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]}
      }
    },
    "cli_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "structured_stdio", "raw_host_terminal", "fields"],
      "properties": {
        "version": {"const": "cli.io.v1"},
        "structured_stdio": {"const": true},
        "raw_host_terminal": {"const": false},
        "fields": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "platform", "architecture", "artifact_ref", "digest", "entrypoint"],
        "properties": {
          "variant_id": {"type": "string"},
          "platform": {"type": "string"},
          "architecture": {"type": "string"},
          "artifact_ref": {"type": "string"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "entrypoint": {"type": "string"},
          "artifact_kind": {"type": "string"}
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchable", "prebuilt_only", "build_during_activation", "dev_commands_reachable"],
      "properties": {
        "launchable": {"type": "boolean"},
        "prebuilt_only": {"type": "boolean"},
        "build_during_activation": {"const": false},
        "dev_commands_reachable": {"const": false},
        "host_security_chrome_owned_by": {"type": "string"}
      }
    },
    "security": {
      "type": "object",
      "required": ["host_authority", "trusted_attention_surface", "native_plugin_loading"],
      "properties": {
        "host_authority": {"enum": ["authenticated_broker_requests_only", "structured_protocol_only"]},
        "trusted_attention_surface": {"const": "host_owned"},
        "native_plugin_loading": {"const": "forbidden"},
        "origin_partition": {"type": "string"}
      }
    }
  }
}
