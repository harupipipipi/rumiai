{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.tobkiri.base-pack.v1",
  "title": "Tobkiri reusable Base Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack_id", "version", "kind", "contracts", "backend", "approval", "shell_requirements", "contributions"],
  "properties": {
    "schema": {"const": "io.tobkiri.pack.v4"},
    "pack_id": {"const": "defaults-basepack"},
    "version": {"type": "string"},
    "kind": {"const": "base"},
    "display_name": {"type": "string"},
    "contracts": {"type": "object"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_ids", "state_owners", "graph", "implementation_pack"],
      "properties": {
        "provider_ids": {"type": "array", "items": {"type": "string"}},
        "state_owners": {"type": "array", "items": {"type": "string"}},
        "graph": {"type": "string"},
        "implementation_pack": {"const": "defaultspack"},
        "implementation_root": {"type": "string"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provider_trust", "grant_state", "authority_mode", "execution_domain", "effect_scope", "blast_radius"],
      "properties": {
        "state": {"enum": ["verified", "pending", "blocked", "not_required"]},
        "provider_trust": {"enum": ["verified", "pending", "blocked", "not_required"]},
        "grant_state": {"enum": ["not_minted", "available", "missing", "blocked"]},
        "authority_mode": {"enum": ["lease_only", "os_entitlement", "none"]},
        "execution_domain": {"type": "string", "minLength": 1},
        "effect_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blast_radius": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]}
      }
    },
    "shell_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "presentation_families", "capabilities"],
      "properties": {
        "contract": {"const": "app.shell.v1"},
        "presentation_families": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contribution_id",
          "owner_pack_id",
          "presentation_family",
          "contract_id",
          "artifact_ref",
          "digest",
          "label",
          "presentation_kind",
          "technology",
          "materialization"
        ],
        "properties": {
          "contribution_id": {"type": "string"},
          "owner_pack_id": {"type": "string"},
          "presentation_family": {"enum": ["graphical", "terminal"]},
          "contract_id": {"type": "string"},
          "artifact_ref": {"type": "string"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "label": {"type": "string", "minLength": 1},
          "presentation_kind": {"type": "string"},
          "technology": {"type": "string"},
          "host_authority": {"type": "string"},
          "materialization": {"const": "selected_only"}
        }
      }
    }
  }
}
