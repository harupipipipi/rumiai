{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.tobkiri.presentation.contribution.v1",
  "title": "Tobkiri presentation contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contribution_id", "experience_role", "presentation_family", "presentation_kind", "technology", "contracts", "artifact_policy"],
  "properties": {
    "schema": {"const": "io.tobkiri.presentation.contribution.v1"},
    "contribution_id": {"type": "string"},
    "experience_role": {"const": "frontend_contribution"},
    "presentation_family": {"enum": ["graphical", "terminal"]},
    "presentation_kind": {"enum": ["declarative", "isolated_web", "terminal_stdio"]},
    "technology": {"type": "string"},
    "contracts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "backend_provider": {"type": "string"},
    "state_owner": {"type": "string"},
    "artifact_policy": {"type": "object"},
    "routes": {"type": "array", "items": {"type": "string"}},
    "panels": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "renderer": {"type": "string"}
  }
}
