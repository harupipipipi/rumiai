{
  "schema": "io.tobkiri.pack.v4",
  "pack_id": "dev.tauri.toolchain.default",
  "version": "1.0.0",
  "kind": "development_toolchain",
  "display_name": "Tobkiri Tauri Development Toolchain",
  "experience_role": "development_toolchain",
  "presentation_kind": "packaged_process",
  "technology": "tauri",
  "contracts": {
    "provides": ["dev.tauri.toolchain.v1"]
  },
  "realm": "development",
  "trust_class": "host_extension",
  "authority_mode": "os_entitlement",
  "production": {
    "launchable": false,
    "prebuilt_only": false,
    "build_during_activation": false,
    "production_realm_reachable": false,
    "fallback_for_production_launch": false
  },
  "development_operations": [
    "project.create",
    "dependencies.materialize",
    "npm.run.dev",
    "cargo.tauri.dev",
    "cargo.tauri.build",
    "bundle.prepare",
    "signing.prepare",
    "diagnostics.collect"
  ],
  "required_capabilities": [
    "development.filesystem",
    "development.process",
    "development.network",
    "development.toolchain"
  ],
  "security": {
    "dedicated_execution_domain": true,
    "approval_policy": "explicit_development_policy",
    "production_launch_fallback": "deny",
    "provider_authority": "function_and_operation_scoped"
  }
}
