{
  "schema": "io.tobkiri.pack.v4",
  "pack_id": "defaultspack",
  "version": "2.0.0",
  "kind": "provider",
  "display_name": "Tobkiri Defaultspack Backend Provider",
  "contracts": {
    "provides": [
      "ai.text.v1",
      "conversation.store.v1",
      "tool.catalog.v1",
      "state.local.v1"
    ]
  },
  "backend": {
    "provider_ids": ["defaultspack"],
    "state_owners": [
      "defaultspack.conversation",
      "defaultspack.agent",
      "defaultspack.tool_catalog",
      "defaultspack.local_settings"
    ],
    "implementation_root": "tobkiri_runtime/ecosystem/defaultspack"
  },
  "runtime": {
    "local_first": true,
    "required_secrets": [],
    "required_network": [],
    "default_model": "stub/default",
    "host_authority": "brokered_only"
  }
}
