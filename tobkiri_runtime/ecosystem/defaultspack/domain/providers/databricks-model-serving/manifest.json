    "default_model_for": {},
    "identity_fields": [
      "workspace",
      "endpoint"
    ],
    "catalog_features": [
      "enterprise",
      "account_scoped_inventory",
      "deployment_identity"
    ]
  },
  "provider_manifest": {
    "id": "databricks-model-serving",
    "category": "llm_provider",
    "version": "1",
    "display_name": "Databricks Model Serving",
    "enabled": true,
    "priority": 300,
    "adapter": "openai_compatible",
    "api_key_env": "DATABRICKS_TOKEN",
