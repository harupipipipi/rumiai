  },
  "aliases": {
    "provider_ids": [
      "mlc-llm-server"
    ]
  },
  "source_pack_id": "defaultspack",
  "catalog_features": [
    "chat",
    "streaming",
    "openai_compatible",
    "runtime_model_discovery"
  ]
