    "default_model_for": {},
    "state_dimensions": [
      "installed",
      "served",
      "loaded",
      "healthy"
    ],
    "catalog_features": [
      "chat",
      "streaming",
      "openai_compatible",
      "runtime_model_discovery"
    ]
  },
  "provider_manifest": {
    "id": "mlc-llm-server",
    "category": "llm_provider",
    "version": "1",
    "display_name": "MLC LLM Server",
    "enabled": true,
    "priority": 400,
    "adapter": "openai_compatible",
    "api_key_env": "MLC_LLM_API_KEY",
    "base_url_env": "MLC_LLM_BASE_URL",
