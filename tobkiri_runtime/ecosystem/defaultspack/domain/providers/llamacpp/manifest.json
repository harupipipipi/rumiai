{
  "id": "llamacpp",
  "provider_id": "llamacpp",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "llama.cpp",
  "description": "llama.cpp single-model or router server inventory.",
  "entrypoints": {"adapter": "../ai_client/providers/llamacpp_provider.py"},
  "security": {"credential_required": false, "local_endpoint": true, "model_management_requires_explicit_action": true},
  "provider_metadata": {
    "display_name": "llama.cpp",
    "kind": "local",
    "env_vars": ["LLAMACPP_API_KEY", "LLAMA_API_KEY"],
    "base_url_envs": ["LLAMACPP_BASE_URL"],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "",
    "default_base_url": "local://llamacpp",
    "default_model_for": {},
    "catalog_features": ["chat", "embedding", "vision", "tool_calls", "openai_compatible", "runtime_model_discovery"]
  },
  "provider_manifest": {
    "id": "llamacpp",
    "category": "llm_provider",
    "version": "1",
    "display_name": "llama.cpp",
    "enabled": true,
    "priority": 170,
    "adapter": "python_entrypoint",
    "entrypoint": "domain.ai_client.providers.llamacpp_provider:LlamaCppProvider",
    "api_key_env": ["LLAMACPP_API_KEY", "LLAMA_API_KEY"],
    "base_url_env": "LLAMACPP_BASE_URL",
    "default_base_url": "local://llamacpp",
    "credential_required": false,
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "api_compatibility": "openai",
      "inference_base_url_default": "http://127.0.0.1:8080/v1",
      "model_sync": "llamacpp_native",
      "single_model_list_path": "/v1/models",
      "router_model_list_path": "/models",
      "props_path": "/props",
      "health_path": "/health",
      "model_cache_ttl_seconds": 60,
      "source_docs": "https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md"
    }
  },
  "aliases": {"provider_ids": ["llamacpp", "llama_cpp"]},
  "compatibility": {"legacy_ids": ["llamacpp", "llama_cpp", "llamacpp/local-gguf"]},
  "source_pack_id": "defaultspack",
  "catalog_features": ["chat", "embedding", "vision", "tool_calls", "openai_compatible", "runtime_model_discovery"]
}
