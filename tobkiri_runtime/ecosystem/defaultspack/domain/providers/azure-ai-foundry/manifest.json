    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "",
    "default_base_url": "https://example.services.ai.azure.com/models",
    "default_model_for": {},
    "identity_fields": [
      "project",
      "deployment"
    ],
    "catalog_features": [
      "enterprise",
      "account_scoped_inventory",
      "deployment_identity"
    ]
  },
  "provider_manifest": {
    "id": "azure-ai-foundry",
    "category": "llm_provider",
    "version": "1",
    "display_name": "Azure AI Foundry",
    "enabled": true,
    "priority": 300,
    "adapter": "openai_compatible",
    "api_key_env": "AZURE_AI_FOUNDRY_API_KEY",
