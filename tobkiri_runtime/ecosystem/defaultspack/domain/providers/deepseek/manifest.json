{
  "id": "deepseek",
  "provider_id": "deepseek",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "DeepSeek",
  "entrypoints": {
    "adapter": "../ai_client/providers/openai_compatible_provider.py",
    "models": "models.json"
  },
  "security": {
    "credential_required": true
  },
  "provider_metadata": {
    "display_name": "DeepSeek",
    "kind": "cloud",
    "env_vars": [
      "DEEPSEEK_API_KEY"
    ],
    "base_url_envs": [
      "DEEPSEEK_BASE_URL"
    ],
    "catalog_only": true,
    "supports_invoke": false,
    "default_model": "deepseek-chat",
    "catalog_features": [
      "chat",
      "reasoning"
    ]
  },
  "provider_manifest": {
    "id": "deepseek",
    "category": "llm_provider",
    "version": "1",
    "display_name": "DeepSeek",
    "enabled": true,
    "priority": 100,
    "adapter": "openai_compatible",
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url_env": "DEEPSEEK_BASE_URL",
    "default_base_url": "https://api.deepseek.com",
    "credential_required": true,
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "deepseek-chat",
    "config": {
      "inventory_strategy": "authenticated_models_api",
      "inventory_scope": "account",
      "model_sync": "remote_merge",
      "model_list_path": "/models",
      "model_cache_ttl_seconds": 21600,
      "source_docs": "https://api-docs.deepseek.com/"
    }
  },
  "aliases": {
    "provider_ids": [
      "deepseek"
    ]
  },
  "compatibility": {
    "legacy_ids": [
      "deepseek"
    ]
  },
  "source_pack_id": "defaultspack",
  "catalog_features": [
    "chat",
    "reasoning"
  ]
}
