{
  "id": "vllm",
  "provider_id": "vllm",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "vLLM",
  "description": "A configured vLLM OpenAI-compatible server and its served models.",
  "entrypoints": {
    "adapter": "../ai_client/providers/vllm_provider.py"
  },
  "security": {
    "credential_required": false,
    "local_endpoint": true,
    "model_management_requires_explicit_action": true
  },
  "provider_metadata": {
    "display_name": "vLLM",
    "kind": "local",
    "description": "Served vLLM inventory; does not scan or load checkpoints.",
    "env_vars": ["VLLM_API_KEY"],
    "base_url_envs": ["VLLM_BASE_URL"],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "",
    "default_base_url": "local://vllm",
    "default_model_for": {},
    "catalog_features": ["chat", "embedding", "rerank", "transcription", "openai_compatible", "runtime_model_discovery"]
  },
  "provider_manifest": {
    "id": "vllm",
    "category": "llm_provider",
    "version": "1",
    "display_name": "vLLM",
    "description": "Configured vLLM server with exact served-name and adapter inventory.",
    "enabled": true,
    "priority": 160,
    "adapter": "python_entrypoint",
    "entrypoint": "domain.ai_client.providers.vllm_provider:VLLMProvider",
    "api_key_env": "VLLM_API_KEY",
    "base_url_env": "VLLM_BASE_URL",
    "default_base_url": "local://vllm",
    "credential_required": false,
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "api_compatibility": "openai",
      "inference_base_url_default": "http://127.0.0.1:8000/v1",
      "model_sync": "vllm_served",
      "model_list_path": "/v1/models",
      "model_cache_ttl_seconds": 60,
      "source_docs": "https://docs.vllm.ai/en/latest/cli/serve/"
    }
  },
  "aliases": {"provider_ids": ["vllm"]},
  "compatibility": {"legacy_ids": ["vllm", "vllm/openai-compatible-model"]},
  "source_pack_id": "defaultspack",
  "catalog_features": ["chat", "embedding", "rerank", "transcription", "openai_compatible", "runtime_model_discovery"]
}
