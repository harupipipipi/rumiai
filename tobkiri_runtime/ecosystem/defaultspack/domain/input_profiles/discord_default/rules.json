{
  "profile": {
    "id": "discord.default",
    "provider": "discord",
    "version": 1,
    "display_name": "Discord Default",
    "match": {
      "event_type": "message"
    },
    "input": {
      "role": "user",
      "content": "coalesce($.content, $.data.options.0.value, $.data.name, 'hello')"
    },
    "metadata": {
      "source": {
        "kind": "integration",
        "provider": "discord"
      },
      "discord": {
        "guild_id": "$.guild_id",
        "channel_id": "$.channel_id",
        "author": "$.author"
      }
    },
    "params": {
      "external_input": {
        "default_response": {
          "mode": "same_response",
          "include_source_context": true,
          "source_context_format": "${provider}\u304b\u3089\u6765\u305f\u5165\u529b\u3067\u3059\u3002"
        }
      }
    },
    "response_prompt": {
      "enabled": false
    }
  }
}
