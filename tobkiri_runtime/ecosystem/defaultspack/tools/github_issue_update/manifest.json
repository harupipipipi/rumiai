{
  "id": "github_issue_update",
  "description": "Update a GitHub issue or append a sync comment via gh CLI when explicitly executed.",
  "config": {
    "tool_id": "github_issue_update",
    "name": "GitHub Issue Update",
    "summary": "Update a GitHub issue or append a sync comment via gh CLI when explicitly executed.",
    "tool_category": "connector",
    "action_type": "network",
    "write_action": true,
    "requires_approval": true,
    "risk": "high",
    "tags": [
      "connector",
      "agent_os",
      "artifact_workspace",
      "issue_sync"
    ],
    "ui": {
      "group_id": "connectors",
      "group_label": "Connectors",
      "group_icon": "plug",
      "item_icon": "plug",
      "widget_kind": "tool_toggle",
      "composer_label": "GitHub Issue Update",
      "composer_description": "Update GitHub issue fields or add sync comments.",
      "composer_icon": "plug"
    },
    "schema": {
      "parameters": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "issue": {
            "type": "string",
            "description": "Issue number, URL, or gh-supported issue reference."
          },
          "issue_number": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "description": "Optional owner/repo override."
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "open, closed, or a status label value."
          },
          "assignee": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "execute": {
            "type": "boolean"
          },
          "timeout": {
            "type": "integer"
          }
        },
        "anyOf": [
          {
            "required": [
              "issue"
            ]
          },
          {
            "required": [
              "issue_number"
            ]
          },
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "key"
            ]
          }
        ]
      }
    },
    "execution": {
      "type": "local",
      "handler": "domain.tool.external_connector_tools:github_issue_update"
    }
  }
}
