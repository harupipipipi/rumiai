{
  "schema_version": 1,
  "id": "rumi.backend.model_routing.default",
  "kind": "backend",
  "version": "1.0.0",
  "status": "active",
  "trust_level": "builtin",
  "capabilities": {
    "provides": [
      "rumi.backend.model_routing",
      "rumi.model_router"
    ],
    "requires": [],
    "permissions": [
      "model.invoke",
      "api_key.use"
    ]
  },
  "metadata": {
    "title": "Default Backend Model Routing",
    "template_kind": "backend_template",
    "local_first": true,
    "description": "Declarative metadata for backend model routing and route diagnostics."
  },
  "pieces": [
    {
      "id": "model_routing_settings_section",
      "kind": "settings_section",
      "order": 30,
      "section_id": "models",
      "label": "Models",
      "description": "Backend routing controls projected from RumiTemplate.",
      "fields": []
    },
    {
      "id": "model_routing_field_renderer",
      "kind": "field_renderer",
      "order": 34,
      "renderer": "model_routing",
      "component": "SettingsFieldRendererHost",
      "part_id": "settings",
      "field_types": [
        "model_api_routes"
      ]
    },
    {
      "id": "model_api_routes",
      "kind": "settings_field",
      "slot": "models",
      "order": 34,
      "section_id": "models",
      "type": "model_api_routes",
      "renderer": "model_routing",
      "component": "SettingsFieldRendererHost",
      "part_id": "settings",
      "label": "Model API Variants",
      "default": "",
      "data_source": "selectable_model_profiles",
      "api_key_source": "provider_key_status",
      "help": "モデルごとに使う API key を選びます。複数選んだら、各 API key ごとに別 model variant として composer に並びます。"
    },
    {
      "id": "model_route_data_source",
      "kind": "function",
      "order": 35,
      "role": "data_source",
      "data_source": "model_route_options",
      "function_id": "ai_route_model",
      "permission_id": "model.invoke",
      "handler_ref": "blocks.ai.route_model:run",
      "route_path": "/api/ai/models/route",
      "method": "POST",
      "returns": "model routing candidates and reason codes"
    },
    {
      "id": "route_model_action",
      "kind": "function",
      "order": 36,
      "role": "action",
      "action_id": "ai_route_model",
      "function_id": "ai_route_model",
      "permission_id": "model.invoke",
      "handler_ref": "blocks.ai.route_model:run",
      "requires_approval": false
    },
    {
      "id": "model_router_service",
      "kind": "backend_service",
      "order": 37,
      "service_id": "model_router",
      "entrypoint": "domain.ai_client.model_router",
      "lifecycle": "local"
    },
    {
      "id": "model_route_permission",
      "kind": "permission",
      "order": 39,
      "permission_id": "model.invoke",
      "scope": "ai_client",
      "reason": "Routing chooses the model used by a later invocation."
    },
    {
      "id": "model_route_api_key_permission",
      "kind": "permission",
      "order": 39,
      "permission_id": "api_key.use",
      "scope": "ai_client",
      "reason": "Routing may inspect local provider key availability without exposing secret values."
    },
    {
      "id": "model_routing_test_contract",
      "kind": "test_contract",
      "order": 40,
      "contract_id": "defaultspack.template.backend.model_routing.catalog",
      "route_metadata": {
        "method": "POST",
        "path": "/api/ai/models/route",
        "block_module": "blocks.ai.route_model",
        "diagnostic": "Template route metadata is catalog/test-contract only and does not register a transport route."
      },
      "assertions": [
        {"type": "catalog_contains", "bucket": "backend_services", "match": {"service_id": "model_router"}},
        {"type": "catalog_contains", "bucket": "test_contracts", "match": {"route_metadata": {"path": "/api/ai/models/route"}}},
        {"type": "route_resolves", "method": "POST", "path": "/api/ai/models/route"},
        {"type": "function_registered", "function_id": "ai_route_model"},
        {"type": "permission_declared", "permission_id": "model.invoke"}
      ]
    }
  ]
}
