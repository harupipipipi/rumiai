{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.dev/effective-subagent/v1.json",
  "title": "Tobkiri Effective Subagent Plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "subagent",
    "placement",
    "bindings",
    "capability_plan_ref",
    "effective_authority",
    "budgets",
    "approval",
    "behavior",
    "enforcement",
    "revisions",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "tobkiri.effective-subagent/v1"},
    "subagent": {"type": "object"},
    "placement": {"type": "object"},
    "bindings": {"type": "array"},
    "protocol_bindings": {"type": "array"},
    "capability_plan_ref": {"type": "string", "minLength": 1},
    "effective_authority": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "budgets": {"type": "object"},
    "approval": {"type": "object"},
    "behavior": {"type": "object"},
    "enforcement": {"type": "object"},
    "revisions": {"type": "object"},
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
