{
  "presets": {
    "full_access": {
      "description": "All handlers — unrestricted access to every capability in the defaults pack",
      "allow": [
        "defaults.*"
      ]
    },
    "chat_only": {
      "description": "Chat and AI handlers only",
      "allow": [
        "defaults.chat.*",
        "defaults.ai.*"
      ]
    },
    "coding_only": {
      "description": "Coding (file and git) handlers only",
      "allow": [
        "defaults.coding.*"
      ]
    },
    "readonly": {
      "description": "Read-only: GET / list / get / query / status handlers only",
      "allow": [
        "defaults.frontend.start",
        "defaults.chat.get_conversation",
        "defaults.chat.list_conversations",
        "defaults.chat.get_message",
        "defaults.chat.search",
        "defaults.agent.status",
        "defaults.coding.file_read",
        "defaults.coding.file_search",
        "defaults.coding.file_list",
        "defaults.coding.git_status",
        "defaults.coding.git_diff",
        "defaults.ai.models",
        "defaults.ai.providers",
        "defaults.tool.list",
        "defaults.tool.schema",
        "defaults.tool.mcp_list",
        "defaults.prompt.list",
        "defaults.memory.recall",
        "defaults.memory.project_context",
        "defaults.memory.vector_query",
        "defaults.media.image_read",
        "defaults.media.clipboard_read"
      ]
    },
    "agent": {
      "description": "Agent preset — agent, chat, AI, tool, coding, memory, and prompt handlers",
      "allow": [
        "defaults.agent.*",
        "defaults.chat.*",
        "defaults.ai.*",
        "defaults.tool.*",
        "defaults.coding.*",
        "defaults.memory.*",
        "defaults.prompt.*"
      ]
    }
  },
  "self_permissions": {
    "description": "Permissions granted to the defaults pack itself at runtime",
    "handlers": [
      "defaults.*"
    ],
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "network.outbound"
    ]
  }
}
