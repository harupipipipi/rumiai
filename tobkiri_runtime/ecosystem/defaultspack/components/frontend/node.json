{
  "version": "rumi.node.v1",
  "nodes": [
    {
      "node_id": "defaultspack.frontend",
      "kind": "ecosystem.component",
      "display_name": {
        "ja": "フロントエンド",
        "en": "Frontend"
      },
      "description": {
        "ja": "UI または CLI surface を提供するノード。",
        "en": "Node that provides UI or CLI surfaces."
      },
      "ports": [
        {
          "id": "ui",
          "direction": "output",
          "display_name": {
            "ja": "UI",
            "en": "UI"
          },
          "standards": ["rumi.ui.surface"],
          "aliases": ["ui", "frontend", "surface"],
          "multiple": true,
          "required": false
        },
        {
          "id": "cli",
          "direction": "output",
          "display_name": {
            "ja": "CLI",
            "en": "CLI"
          },
          "standards": ["rumi.cli.surface"],
          "aliases": ["cli", "terminal", "surface"],
          "multiple": true,
          "required": false
        },
        {
          "id": "surface",
          "direction": "input",
          "display_name": {
            "ja": "サーフェス",
            "en": "Surface"
          },
          "standards": ["rumi.cli.surface"],
          "aliases": ["surface", "cli_surface"],
          "multiple": false,
          "required": false
        }
      ],
      "bindings": {
        "compile": "defaultspack:frontend.compile_node",
        "on_input": {
          "surface": "defaultspack:frontend.bind_surface"
        }
      },
      "metadata": {
        "pack_id": "defaultspack",
        "component": "frontend",
        "icon": "monitor",
        "category": "surface"
      }
    },
    {
      "node_id": "defaultspack.cli_surface",
      "kind": "ecosystem.component",
      "display_name": {
        "ja": "CLI サーフェス",
        "en": "CLI Surface"
      },
      "description": {
        "ja": "フロントエンドに接続できる CLI surface ノード。",
        "en": "CLI surface node that can bind into a frontend."
      },
      "ports": [
        {
          "id": "surface",
          "direction": "output",
          "display_name": {
            "ja": "サーフェス",
            "en": "Surface"
          },
          "standards": ["rumi.cli.surface"],
          "aliases": ["cli", "surface"],
          "multiple": true,
          "required": false
        }
      ],
      "bindings": {
        "compile": "defaultspack:cli_surface.compile_node"
      },
      "metadata": {
        "pack_id": "defaultspack",
        "component": "frontend",
        "icon": "terminal",
        "category": "surface"
      }
    }
  ]
}
