{
  "components": {},
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "description": "Declarative end-to-end agent QA, scenario replay, acceptance, and regression triage pack.",
  "display_name": "Rumi Agentic QA Pack",
  "load_order": [],
  "metadata": {
    "asset_index": {
      "catalog": [
        "catalog/agentic_qa_scenarios.yaml",
        "catalog/qa_routing_matrix.yaml",
        "catalog/acceptance_rubric.yaml",
        "catalog/scenario_catalog.yaml"
      ],
      "checklist": [
        "checklists/qa_replay.checklist.yaml"
      ],
      "docs": [
        "docs/README.md",
        "docs/architecture.md",
        "docs/interfaces.md",
        "docs/operations.md"
      ],
      "example": [
        "examples/agent_regression_case.example.yaml",
        "examples/cross_pack_acceptance.example.yaml",
        "examples/failure_triage.example.yaml"
      ],
      "ledger": [
        "ledgers/qa_evidence_ledger.schema.yaml"
      ],
      "policy": [
        "policies/agentic_qa_gate.policy.yaml"
      ],
      "presets": [
        "presets/safe_default.preset.yaml",
        "presets/handoff_review.preset.yaml",
        "presets/quality_gate.preset.yaml"
      ],
      "profiles": [
        "profiles/agentic_qa_reviewer.profile.yaml"
      ],
      "prompts": [
        "prompts/agentic_qa_reviewer.system.md"
      ],
      "readme": [
        "README.md"
      ],
      "spec": [],
      "template": [
        "templates/regression_triage_report.template.yaml"
      ]
    },
    "declarative_only": true,
    "executable_code": false,
    "network_policy": "none_by_default",
    "optional_integrations": [
      {
        "pack_id": "rumi_model_evals_pack",
        "reason": "Model scoring and benchmark execution are delegated to model evals; this pack owns scenario and acceptance contracts."
      },
      {
        "pack_id": "rumi_browser_automation_pack",
        "reason": "Browser replay and screenshots are delegated to browser automation; this pack records expected and actual observations."
      },
      {
        "pack_id": "rumi_security_review_pack",
        "reason": "Unsafe behavior investigation is delegated to security review; this pack captures triage evidence and owner handoff."
      },
      {
        "pack_id": "rumi_observability_pack",
        "reason": "Durable run ledgers and trend metrics are delegated to observability; this pack declares evidence ledger requirements."
      }
    ],
    "owner_surfaces": [
      "scenario_replay",
      "acceptance_matrix",
      "regression_triage",
      "cross_pack_quality_gates",
      "qa_routing_matrix",
      "acceptance_rubric",
      "qa_evidence_ledger",
      "replay_checklist",
      "regression_triage_template",
      "scenario_catalog"
    ],
    "required_secrets": []
  },
  "pack_id": "rumi_agentic_qa_pack",
  "pack_identity": "rumi:ecosystem/rumi_agentic_qa_pack",
  "version": "0.1.0",
  "vocabulary": {
    "types": [
      "qa",
      "catalog",
      "policy",
      "profile",
      "prompt",
      "preset",
      "example",
      "checklist",
      "ledger",
      "template"
    ]
  }
}
