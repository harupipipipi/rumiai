{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/compaction_handoff.schema.json",
  "title": "Compaction Handoff",
  "description": "Agent continuity contract schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "conversation_ref",
    "pre_compaction_anchor",
    "post_compaction_summary",
    "lost_context_risks",
    "must_preserve",
    "resume_instructions",
    "owner_boundary_review"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_ref": {
      "type": "string",
      "minLength": 1
    },
    "pre_compaction_anchor": {
      "type": "string",
      "minLength": 1
    },
    "post_compaction_summary": {
      "type": "string",
      "minLength": 1
    },
    "lost_context_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "must_preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resume_instructions": {
      "type": "string",
      "minLength": 1
    },
    "owner_boundary_review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
