{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/opportunity_map.schema.json",
  "title": "Opportunity Map",
  "description": "Contract schema for Opportunity Map.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "insight_ids",
    "opportunity_areas",
    "assumptions",
    "decision_boundary",
    "handoff_owner"
  ],
  "properties": {
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "insight_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "opportunity_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area_id",
          "evidence_ids",
          "customer_problem",
          "risk_notes"
        ],
        "properties": {
          "area_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "customer_problem": {
            "type": "string",
            "minLength": 1
          },
          "risk_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "decision_boundary": {
      "type": "string",
      "const": "does_not_make_roadmap_decision"
    },
    "handoff_owner": {
      "type": "string",
      "const": "future_product_strategy_owner"
    }
  }
}
