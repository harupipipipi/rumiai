{
  "capabilities": [
    "host.microphone.capture",
    "host.camera.capture",
    "ambient.trigger.dispatch"
  ],
  "dependencies": {
    "defaultspack": ">=2.0.0"
  },
  "metadata": {
    "author": "Rumi AI Team",
    "description": "Voice wake, camera pinch, 2/3/4 gesture replies, and approval gesture extension for defaultspack input.",
    "legacy_annotations": {
      "frontend_extensions": [
        "frontend_extensions/ambient_trigger.ui.json"
      ],
      "permissions_required": {
        "ambient.trigger.dispatch": {
          "label": "Create Rumi input from ambient triggers",
          "requires_user_grant": true,
          "risk": "medium"
        },
        "host.camera.capture": {
          "label": "Camera capture",
          "os_permission_hint": "Windows/macOS/Linux camera permission may also be required.",
          "requires_user_grant": true,
          "risk": "high"
        },
        "host.microphone.capture": {
          "label": "Microphone capture",
          "os_permission_hint": "Windows/macOS/Linux microphone permission may also be required.",
          "requires_user_grant": true,
          "risk": "high"
        }
      },
      "policy": {
        "audit": "trigger_events_only",
        "privacy": "policies/ambient_privacy.policy.yaml"
      },
      "services": {
        "ambient_trigger_router": {
          "dispatches_to": [
            "chat.message",
            "run.instruction",
            "agent.delegate",
            "defaults.console.input"
          ]
        },
        "gesture_wake_monitor": {
          "approval_mode": "index_swipe_or_button_number_without_pinch",
          "choice_reply_mode": "pinch_plus_2_3_4_hold_for_3s",
          "default_enabled": false,
          "mode": "thumb_index_landmark_distance"
        },
        "voice_wake_monitor": {
          "default_enabled": false,
          "mode": "wake_phrase_enrollment_audio_embedding"
        }
      }
    },
    "license": "MIT",
    "name": "Rumi Ambient Trigger Pack"
  },
  "pack_id": "rumi_ambient_trigger_pack",
  "pack_identity": "rumi:ecosystem/rumi_ambient_trigger_pack",
  "version": "0.1.0",
  "vocabulary": {
    "types": [
      "service"
    ]
  }
}
