{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/contract.v4.schema.json",
  "title": "Tobkiri Contract v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_api_version", "contract_id", "version", "revision_digest", "status", "operations", "provenance"],
  "properties": {
    "contract_api_version": {"const": "io.tobkiri.contract.v4"},
    "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "status": {"enum": ["draft", "accepted", "deprecated", "sunset"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "input_schema_digest", "output_schema_digest", "error_schema_digest", "effect_ceiling"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "input_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "output_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "error_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "progress_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "effect_ceiling": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "scope_semantics_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "scope_semantics": {"enum": ["declarative", "host_broker", "opaque", "unknown"]},
          "idempotency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["none", "keyed", "replayable"]},
              "key_namespace": {"type": "string"},
              "reconcile_operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
              "retention_seconds": {"type": "integer", "minimum": 0}
            }
          },
          "timeout_default_ms": {"type": "integer", "minimum": 1},
          "timeout_hard_max_ms": {"type": "integer", "minimum": 1}
        }
      }
    },
    "provenance": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/provenance"}
  }
}
