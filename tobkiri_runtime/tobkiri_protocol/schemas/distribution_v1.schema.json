{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/distribution.v1.schema.json",
  "title": "Tobkiri Distribution manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["distribution_api_version", "distribution_id", "version", "packs", "provenance"],
  "properties": {
    "distribution_api_version": {"const": "io.tobkiri.distribution.v1"},
    "distribution_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "packs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["pack_id", "artifact_digest"], "properties": {"pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "version": {"type": "string"}}}},
    "recommended_edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_pack_id", "to_pack_id", "contract_id"], "properties": {"from_pack_id": {"type": "string"}, "to_pack_id": {"type": "string"}, "contract_id": {"type": "string"}}}},
    "provenance": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/provenance"}
  }
}
