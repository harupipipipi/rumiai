{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/pack-manifest.v4.schema.json",
  "title": "Tobkiri Pack Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_api_version", "pack", "functions", "contracts", "artifacts", "provenance", "migration"],
  "properties": {
    "pack_api_version": {"const": "io.tobkiri.pack.v4"},
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "artifact_digest", "display_name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "kind": {"enum": ["normal_sandbox", "host_extension", "base", "shell", "application"]},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "display_name": {"type": "string", "minLength": 1},
        "publisher_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "signing_lineage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "implementation_digest", "contract_revision_digest", "operations", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "implementation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "contract_revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "uniqueItems": true},
          "role": {"enum": ["pure", "vendor_semantic", "brokered", "host_capability_provider"]},
          "isolation": {"enum": ["wasm_component", "pack_vm", "dedicated_process", "remote"]}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "revision_digest", "operations"],
        "properties": {
          "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
          "revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "uniqueItems": true}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "kind": {"enum": ["executable", "schema", "asset", "variant", "sidecar"]},
          "platform": {"type": "string"}
        }
      }
    },
    "provenance": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/provenance"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "legacy_ids", "removal_wave", "sunset_at"],
      "properties": {
        "compatibility": {"enum": ["none", "read_only"]},
        "legacy_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "removal_wave": {"type": "integer", "minimum": 0},
        "sunset_at": {"type": "string", "format": "date"}
      }
    }
  }
}
