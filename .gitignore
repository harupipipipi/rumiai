# === git root (rumi_ai/) 用 ===
/*
!.gitignore
!/.github/
!/rumi_ai_1_10/
!/rumi_viewer/
!/pack-shell/
!/tests/

# 整理退避用ディレクトリは Git 管理しない
/others/

# === 共通の不要ファイル ===
venv/
__pycache__/
*.pyc
.DS_Store
*.exe
*.zip
*.bak
*.bak.*
.env.local
.env.*
apikey.env
sample.env.local
.vscode/
node_modules/
dist/

# フロントエンドビルド成果物（配布に必要なので除外しない）
!rumi_ai_1_10/core_runtime/core_pack/*/web/

# === rumi_ai_1_10/ 内の不要ファイル ===
chats/
userdata/
tenpu/
debug.txt
erroer_memo.txt
flow.iranai
.backups/
.backup_dead_code_removal/
deploy.py
**/target/
rumi_ai_1_10/user_data/
