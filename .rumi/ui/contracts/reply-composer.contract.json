{
  "id": "reply-composer",
  "purpose": "Reply safely to the current conversation",
  "primaryPerceptualTask": "Understand draft state and whether sending is safe",
  "density": "comfortable",
  "layoutEnvelope": {
    "minWidth": 280,
    "preferredWidth": 560,
    "maxWidth": 760,
    "heightBehavior": "content",
    "mobileBehavior": "sticky-bottom"
