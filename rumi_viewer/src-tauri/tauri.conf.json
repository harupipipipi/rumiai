{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rumi AI",
  "version": "0.1.0",
  "identifier": "dev.rumiai.app",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' http://localhost:8765; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8765"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Rumi AI",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../rumi_ai_1_10/": "app/",
      "bundled/": "app/bundled/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
